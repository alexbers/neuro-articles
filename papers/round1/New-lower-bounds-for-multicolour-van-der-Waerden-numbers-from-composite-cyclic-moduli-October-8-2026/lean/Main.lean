/-
  New lower bounds for multicolour van der Waerden numbers W(r,k), r = 4,5,6.
  Self-contained (Lean core only, no Mathlib).  Agent A05.

  Notation: W(r,k) = least N such that every r-colouring of {1,…,N} contains a
  monochromatic k-term arithmetic progression.  `VdWGt r k N` below says
  "W(r,k) > N", i.e. there is an r-colouring of N consecutive integers
  (we use {0,…,N-1}) with no monochromatic k-term AP.
-/
set_option autoImplicit false

/-! ## 1. Definitions used in the main theorems -/

/-- `c` has no monochromatic `k`-term arithmetic progression (with positive common
difference) inside `{0, 1, …, N-1}`. -/
def NoMonoAP (k N : Nat) (c : Nat → Nat) : Prop :=
  ∀ a d : Nat, 0 < d → a + (k - 1) * d < N → ∃ i, i < k ∧ c (a + i * d) ≠ c a

/-- `VdWGt r k N` : W(r,k) > N, i.e. some colouring of `{0,…,N-1}` with colours
`0,…,r-1` has no monochromatic `k`-term arithmetic progression. -/
def VdWGt (r k N : Nat) : Prop :=
  ∃ c : Nat → Nat, (∀ x, x < N → c x < r) ∧ NoMonoAP k N c

/-! ## 2. Auxiliary notion: colourings of the cyclic group Z/nZ -/

/-- `χ` restricted to `{0,…,n-1}` (viewed as Z/nZ) has no monochromatic cyclic `k`-AP
`a, a+d, …, a+(k-1)d (mod n)` with `d ≢ 0 (mod n)`. -/
def CycNoMonoAP (k n : Nat) (χ : Nat → Nat) : Prop :=
  ∀ a d : Nat, a < n → 0 < d → d < n → ∃ i, i < k ∧ χ ((a + i * d) % n) ≠ χ a

theorem mod_ap (a d i n : Nat) : (a + i * d) % n = (a % n + i * (d % n)) % n := by
  have e1 := Nat.div_add_mod a n
  have e2 := Nat.div_add_mod d n
  have h : a + i * d = (a % n + i * (d % n)) + n * (a / n + i * (d / n)) := by
    have h3 : i * d = i * (n * (d / n) + d % n) := by rw [e2]
    rw [h3, Nat.mul_add, Nat.mul_add, Nat.mul_left_comm i n]
    omega
  rw [h, Nat.add_mul_mod_self_left]

theorem mul_mod_inner (m x n : Nat) : (m * (x % n)) % n = (m * x) % n := by
  rw [Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod]

/-! ## 3. The blow-up (cover × interval) theorem

Let `F : Z/n × {0..t-1} → colours` be injective in the second argument and such that
for every colour `γ` the set `P_γ = {z : ∃ u < t, F z u = γ}` contains no cyclic `k`-AP.
If `ψ` is a `t`-colouring of `{0..M-1}` without monochromatic `k`-AP, then
`x ↦ F (x mod n) (ψ (x / n))` has no monochromatic `k`-AP on `{0..nM-1}`.
Special cases: products of a cyclic colouring with an interval colouring (Xu), and the
block blow-up of Blankenship–Cummings–Taranchuk. -/
theorem blowup {k n M t : Nat} (hn : 0 < n) (F : Nat → Nat → Nat) (ψ : Nat → Nat)
    (hF : ∀ z u v, u < t → v < t → F z u = F z v → u = v)
    (hcov : ∀ γ a d, a < n → 0 < d → d < n →
      ∃ i, i < k ∧ ∀ u, u < t → F ((a + i * d) % n) u ≠ γ)
    (hψ : NoMonoAP k M ψ) (hψt : ∀ y, y < M → ψ y < t) :
    NoMonoAP k (n * M) (fun x => F (x % n) (ψ (x / n))) := by
  intro a d hd hlt
  by_cases hdn : d % n = 0
  · have hq : d = n * (d / n) := by have := Nat.div_add_mod d n; omega
    obtain ⟨q, rfl⟩ : ∃ q, d = n * q := ⟨d / n, hq⟩
    have hq0 : 0 < q := by
      apply Nat.pos_of_ne_zero; intro h0; rw [h0, Nat.mul_zero] at hd; exact Nat.lt_irrefl 0 hd
    have hmod : ∀ i, (a + i * (n * q)) % n = a % n := by
      intro i; rw [Nat.mul_left_comm, Nat.add_mul_mod_self_left]
    have hdiv : ∀ i, (a + i * (n * q)) / n = a / n + i * q := by
      intro i; rw [Nat.mul_left_comm, Nat.add_mul_div_left _ _ hn]
    have h1 : a / n + (k - 1) * q < M := by
      apply Nat.lt_of_mul_lt_mul_left (a := n)
      have := Nat.mul_div_le a n
      rw [Nat.mul_add, Nat.mul_left_comm n (k - 1) q]
      omega
    obtain ⟨i, hi, hne⟩ := hψ (a / n) q hq0 h1
    refine ⟨i, hi, fun heq => hne ?_⟩
    simp only at heq
    rw [hmod i, hdiv i] at heq
    have hiq : i * q ≤ (k - 1) * q := Nat.mul_le_mul_right q (by omega)
    exact hF _ _ _ (hψt _ (by omega)) (hψt _ (by omega)) heq
  · have hd' : 0 < d % n := Nat.pos_of_ne_zero hdn
    obtain ⟨i, hi, hall⟩ :=
      hcov (F (a % n) (ψ (a / n))) (a % n) (d % n) (Nat.mod_lt _ hn) hd' (Nat.mod_lt _ hn)
    refine ⟨i, hi, ?_⟩
    show F ((a + i * d) % n) (ψ ((a + i * d) / n)) ≠ F (a % n) (ψ (a / n))
    rw [mod_ap a d i n]
    apply hall
    apply hψt
    apply Nat.div_lt_of_lt_mul
    have : i * d ≤ (k - 1) * d := Nat.mul_le_mul_right d (by omega)
    omega

/-! ## 4. Small helper lemmas -/

theorem NoMonoAP.congr {k N : Nat} {c c' : Nat → Nat} (h : NoMonoAP k N c)
    (he : ∀ x, x < N → c' x = c x) : NoMonoAP k N c' := by
  intro a d hd hlt
  obtain ⟨i, hi, hne⟩ := h a d hd hlt
  have hid : i * d ≤ (k - 1) * d := Nat.mul_le_mul_right d (by omega)
  refine ⟨i, hi, ?_⟩
  rw [he _ (by omega), he _ (by omega)]
  exact hne

/-- Appending one element at the end. -/
theorem NoMonoAP.extend_one {k N : Nat} {c : Nat → Nat} (h : NoMonoAP k N c)
    (hlast : ∀ d, 0 < d → (k - 1) * d ≤ N →
      ∃ i, i < k ∧ c (N - (k - 1) * d + i * d) ≠ c (N - (k - 1) * d)) :
    NoMonoAP k (N + 1) c := by
  intro a d hd hlt
  by_cases hN : a + (k - 1) * d < N
  · exact h a d hd hN
  · have ha : a = N - (k - 1) * d := by omega
    have hle : (k - 1) * d ≤ N := by omega
    subst ha
    exact hlast d hd hle

theorem VdWGt.of_eq {r k N N' : Nat} (h : VdWGt r k N) (e : N = N') : VdWGt r k N' := e ▸ h

/-- Translating a cyclic colouring. -/
theorem CycNoMonoAP.shift {k n : Nat} {χ : Nat → Nat} (hn : 0 < n) (h : CycNoMonoAP k n χ)
    (s : Nat) : CycNoMonoAP k n (fun z => χ ((z + s) % n)) := by
  intro a d ha hd hdn
  obtain ⟨i, hi, hne⟩ := h ((a + s) % n) d (Nat.mod_lt _ hn) hd hdn
  refine ⟨i, hi, ?_⟩
  have e : ((a + i * d) % n + s) % n = ((a + s) % n + i * d) % n := by
    rw [Nat.mod_add_mod, Nat.mod_add_mod]
    congr 1
    omega
  simp only
  rw [e]
  exact hne

/-- The cover condition for a product colouring `F z u = t * χ z + u`. -/
theorem hcov_prod {k n t : Nat} {χ : Nat → Nat} (hk : 0 < k) (ht : 0 < t)
    (hχ : CycNoMonoAP k n χ) :
    ∀ γ a d, a < n → 0 < d → d < n →
      ∃ i, i < k ∧ ∀ u, u < t → t * χ ((a + i * d) % n) + u ≠ γ := by
  intro γ a d ha hd hdn
  have key : ∀ z u, u < t → (t * z + u) / t = z := by
    intro z u hu
    rw [Nat.add_comm, Nat.add_mul_div_left _ _ ht, Nat.div_eq_of_lt hu, Nat.zero_add]
  by_cases hγ : χ a = γ / t
  · obtain ⟨i, hi, hne⟩ := hχ a d ha hd hdn
    refine ⟨i, hi, fun u hu heq => hne ?_⟩
    rw [hγ, ← heq, key _ _ hu]
  · refine ⟨0, hk, fun u hu heq => hγ ?_⟩
    rw [Nat.zero_mul, Nat.add_zero, Nat.mod_eq_of_lt ha] at heq
    rw [← heq, key _ _ hu]

/-- Product of a cyclic `s`-colouring of Z/n with an interval `t`-colouring. -/
theorem product {k n M s t : Nat} (hk : 0 < k) (hn : 0 < n) (ht : 0 < t) {χ ψ : Nat → Nat}
    (hχ : CycNoMonoAP k n χ) (hχs : ∀ z, z < n → χ z < s)
    (hψ : NoMonoAP k M ψ) (hψt : ∀ y, y < M → ψ y < t) :
    VdWGt (s * t) k (n * M) := by
  refine ⟨fun x => t * χ (x % n) + ψ (x / n), ?_, ?_⟩
  · intro x hx
    have h1 := hχs (x % n) (Nat.mod_lt _ hn)
    have h2 := hψt (x / n) (Nat.div_lt_of_lt_mul hx)
    have : t * χ (x % n) + t ≤ t * s := by
      rw [← Nat.mul_succ]; exact Nat.mul_le_mul_left t h1
    show t * χ (x % n) + ψ (x / n) < s * t
    rw [Nat.mul_comm s t]; omega
  · exact blowup hn (fun z u => t * χ z + u) ψ (by intro z u v _ _ h; omega)
      (hcov_prod hk ht hχ) hψ hψt

/-- Unrolling a cyclic colouring `k-1` times. -/
theorem unroll {k n : Nat} (hk : 0 < k) (hn : 0 < n) {χ : Nat → Nat}
    (hχ : CycNoMonoAP k n χ) : NoMonoAP k (n * (k - 1)) (fun x => χ (x % n)) := by
  have h0 : NoMonoAP k (k - 1) (fun _ => 0) := by
    intro a d hd hlt
    have : k - 1 ≤ (k - 1) * d := Nat.le_mul_of_pos_right _ hd
    omega
  have := blowup (t := 1) hn (fun z u => 1 * χ z + u) (fun _ => 0)
    (by intro z u v _ _ h; omega) (hcov_prod hk (by decide) hχ) h0 (by intro _ _; decide)
  exact this.congr (by intro x _; simp)

theorem unrollN {k n N : Nat} (hk : 0 < k) (hn : 0 < n) {χ : Nat → Nat}
    (hχ : CycNoMonoAP k n χ) (hN : n * (k - 1) = N) : NoMonoAP k N (fun x => χ (x % n)) :=
  hN ▸ unroll hk hn hχ

/-! ## 5. Boolean checkers and their soundness -/

def allBelow : Nat → (Nat → Bool) → Bool
  | 0, _ => true
  | n + 1, p => p n && allBelow n p

def anyBelow : Nat → (Nat → Bool) → Bool
  | 0, _ => false
  | n + 1, p => p n || anyBelow n p

theorem allBelow_spec {n : Nat} {p : Nat → Bool} (h : allBelow n p = true) :
    ∀ i, i < n → p i = true := by
  induction n with
  | zero => intro i hi; exact absurd hi (Nat.not_lt_zero _)
  | succ n ih =>
    simp only [allBelow, Bool.and_eq_true] at h
    intro i hi
    by_cases hin : i = n
    · subst hin; exact h.1
    · exact ih h.2 i (by omega)

theorem anyBelow_spec {n : Nat} {p : Nat → Bool} (h : anyBelow n p = true) :
    ∃ i, i < n ∧ p i = true := by
  induction n with
  | zero => simp [anyBelow] at h
  | succ n ih =>
    simp only [anyBelow, Bool.or_eq_true] at h
    rcases h with h | h
    · exact ⟨n, by omega, h⟩
    · obtain ⟨i, hi, hp⟩ := ih h; exact ⟨i, by omega, hp⟩

/-- Row check of a cyclic colouring: all APs starting at `a` with `1 ≤ d ≤ D`. -/
def cycRow (χ : Nat → Nat) (n k D a : Nat) : Bool :=
  allBelow D (fun e => anyBelow k (fun i => χ ((a + i * (e + 1)) % n) != χ a))

/-- Reversal: it suffices to check differences `d ≤ n/2`. -/
theorem cyc_of_rows {k n : Nat} {χ : Nat → Nat} (hk : 0 < k) (hn : 0 < n)
    (h : ∀ a, a < n → cycRow χ n k (n / 2) a = true) : CycNoMonoAP k n χ := by
  -- first: all `d ≤ n/2`
  have half : ∀ a d, a < n → 0 < d → d ≤ n / 2 → ∃ i, i < k ∧ χ ((a + i * d) % n) ≠ χ a := by
    intro a d ha hd hdh
    obtain ⟨i, hi, hp⟩ := anyBelow_spec (allBelow_spec (h a ha) (d - 1) (by omega))
    refine ⟨i, hi, ?_⟩
    have : d - 1 + 1 = d := by omega
    rw [this] at hp
    simpa using hp
  intro a d ha hd hdn
  by_cases hdh : d ≤ n / 2
  · exact half a d ha hd hdh
  · -- reverse the progression: start at a' = (a+(k-1)d) % n with difference d' = n - d
    obtain ⟨i, hi, hne⟩ := half ((a + (k - 1) * d) % n) (n - d) (Nat.mod_lt _ hn) (by omega)
      (by omega)
    -- term i of the reversed AP is term (k-1-i) of the original one
    have e : ∀ j, j < k → ((a + (k - 1) * d) % n + j * (n - d)) % n
        = (a + (k - 1 - j) * d) % n := by
      intro j hj
      have h1 : (k - 1) * d = (k - 1 - j) * d + j * d := by
        rw [← Nat.add_mul]; congr 1; omega
      have h2 : j * (n - d) + j * d = j * n := by
        rw [← Nat.mul_add]; congr 1; omega
      rw [Nat.mod_add_mod]
      have h3 : a + (k - 1) * d + j * (n - d) = a + (k - 1 - j) * d + n * j := by
        rw [Nat.mul_comm n j]; omega
      rw [h3, Nat.add_mul_mod_self_left]
    rw [e i hi] at hne
    by_cases h0 : χ ((a + (k - 1 - i) * d) % n) = χ a
    · exact ⟨k - 1, by omega, fun h' => hne (by rw [h0, h'])⟩
    · exact ⟨k - 1 - i, by omega, h0⟩

/-- Checker using a multiplicative symmetry `z ↦ m z` of `χ` and a table `s` of
"steps to an orbit representative" (representatives are the `d` with `s d = 0`). -/
def symOK1 (χ : Nat → Nat) (n m : Nat) : Bool :=
  allBelow n (fun z => χ ((m * z) % n) == χ z)

def symOK2 (s : Nat → Nat) (n m : Nat) : Bool :=
  allBelow n (fun d => d == 0 || ((m * d) % n != 0 && (s d == 0 || s ((m * d) % n) + 1 == s d)))

def symOK3 (χ s : Nat → Nat) (n k : Nat) : Bool :=
  allBelow n (fun d => d == 0 || s d != 0 ||
    allBelow n (fun a => anyBelow k (fun i => χ ((a + i * d) % n) != χ a)))

theorem cyc_of_sym {k n m : Nat} {χ s : Nat → Nat} (hn : 0 < n)
    (h1 : symOK1 χ n m = true) (h2 : symOK2 s n m = true) (h3 : symOK3 χ s n k = true) :
    CycNoMonoAP k n χ := by
  have H1 : ∀ z, z < n → χ ((m * z) % n) = χ z := by
    intro z hz; have := allBelow_spec h1 z hz; simpa using this
  have H2 : ∀ d, 0 < d → d < n → (m * d) % n ≠ 0 ∧ (s d = 0 ∨ s ((m * d) % n) + 1 = s d) := by
    intro d hd hdn
    have := allBelow_spec h2 d hdn
    simp only [Bool.or_eq_true, beq_iff_eq, Bool.and_eq_true, bne_iff_ne, ne_eq] at this
    rcases this with h | h
    · omega
    · exact h
  have H3 : ∀ d, 0 < d → d < n → s d = 0 → ∀ a, a < n →
      ∃ i, i < k ∧ χ ((a + i * d) % n) ≠ χ a := by
    intro d hd hdn hs a ha
    have := allBelow_spec h3 d hdn
    simp only [Bool.or_eq_true, beq_iff_eq, bne_iff_ne, ne_eq] at this
    rcases this with (h | h) | h
    · omega
    · exact absurd hs h
    · obtain ⟨i, hi, hp⟩ := anyBelow_spec (allBelow_spec h a ha)
      exact ⟨i, hi, by simpa using hp⟩
  -- strong induction on the number of steps
  have main : ∀ j a d, s d ≤ j → a < n → 0 < d → d < n →
      ∃ i, i < k ∧ χ ((a + i * d) % n) ≠ χ a := by
    intro j
    induction j with
    | zero =>
      intro a d hs ha hd hdn
      exact H3 d hd hdn (by omega) a ha
    | succ j ih =>
      intro a d hs ha hd hdn
      rcases (H2 d hd hdn).2 with h0 | hstep
      · exact H3 d hd hdn h0 a ha
      · obtain ⟨i, hi, hne⟩ := ih ((m * a) % n) ((m * d) % n) (by omega) (Nat.mod_lt _ hn)
          (Nat.pos_of_ne_zero (H2 d hd hdn).1) (Nat.mod_lt _ hn)
        refine ⟨i, hi, fun heq => hne ?_⟩
        rw [← mod_ap, ← Nat.mul_assoc, Nat.mul_comm i m, Nat.mul_assoc, ← Nat.mul_add,
          ← mul_mod_inner, H1 _ (Nat.mod_lt _ hn), heq, H1 a ha]
  intro a d ha hd hdn
  exact main (s d) a d (Nat.le_refl _) ha hd hdn

/-! ### Chunked range checks (keeps kernel memory per declaration small) -/

def allRange (lo len : Nat) (p : Nat → Bool) : Bool := allBelow len (fun j => p (lo + j))

theorem all_of_chunks {p : Nat → Bool} {L C : Nat}
    (h : ∀ c, c < C → allRange (c * L) L p = true) : ∀ i, i < C * L → p i = true := by
  intro i hi
  have hL : 0 < L := by
    rcases Nat.eq_zero_or_pos L with h0 | h0
    · rw [h0, Nat.mul_zero] at hi; omega
    · exact h0
  have hc : i / L < C := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hi)
  have := allBelow_spec (h (i / L) hc) (i % L) (Nat.mod_lt _ hL)
  have e : i / L * L + i % L = i := by rw [Nat.mul_comm]; exact Nat.div_add_mod i L
  rw [e] at this
  exact this

theorem all_of_chunks_lt {p : Nat → Bool} {L C n : Nat}
    (h : ∀ c, c < C → allRange (c * L) L (fun i => decide (n ≤ i) || p i) = true)
    (hn : n ≤ C * L) : ∀ i, i < n → p i = true := by
  intro i hi
  have := all_of_chunks h i (by omega)
  simp only [Bool.or_eq_true, decide_eq_true_eq] at this
  rcases this with h1 | h1
  · omega
  · exact h1

/-- Prop-level version of the symmetry checker. -/
theorem cyc_of_symP {k n m : Nat} {χ s : Nat → Nat} (hn : 0 < n)
    (H1 : ∀ z, z < n → χ ((m * z) % n) = χ z)
    (H2 : ∀ d, 0 < d → d < n → (m * d) % n ≠ 0 ∧ (s d = 0 ∨ s ((m * d) % n) + 1 = s d))
    (H3 : ∀ d, 0 < d → d < n → s d = 0 → ∀ a, a < n →
      ∃ i, i < k ∧ χ ((a + i * d) % n) ≠ χ a) :
    CycNoMonoAP k n χ := by
  have main : ∀ j a d, s d ≤ j → a < n → 0 < d → d < n →
      ∃ i, i < k ∧ χ ((a + i * d) % n) ≠ χ a := by
    intro j
    induction j with
    | zero =>
      intro a d hs ha hd hdn
      exact H3 d hd hdn (by omega) a ha
    | succ j ih =>
      intro a d hs ha hd hdn
      rcases (H2 d hd hdn).2 with h0 | hstep
      · exact H3 d hd hdn h0 a ha
      · obtain ⟨i, hi, hne⟩ := ih ((m * a) % n) ((m * d) % n) (by omega) (Nat.mod_lt _ hn)
          (Nat.pos_of_ne_zero (H2 d hd hdn).1) (Nat.mod_lt _ hn)
        refine ⟨i, hi, fun heq => hne ?_⟩
        rw [← mod_ap, ← Nat.mul_assoc, Nat.mul_comm i m, Nat.mul_assoc, ← Nat.mul_add,
          ← mul_mod_inner, H1 _ (Nat.mod_lt _ hn), heq, H1 a ha]
  intro a d ha hd hdn
  exact main (s d) a d (Nat.le_refl _) ha hd hdn

def symP1 (χ : Nat → Nat) (n m z : Nat) : Bool := χ ((m * z) % n) == χ z

def symP2 (s : Nat → Nat) (n m d : Nat) : Bool :=
  d == 0 || ((m * d) % n != 0 && (s d == 0 || s ((m * d) % n) + 1 == s d))

def apP (χ : Nat → Nat) (n k r a : Nat) : Bool := anyBelow k (fun i => χ ((a + i * r) % n) != χ a)

theorem symP1_spec {χ : Nat → Nat} {n m : Nat} (h : ∀ z, z < n → symP1 χ n m z = true) :
    ∀ z, z < n → χ ((m * z) % n) = χ z := by
  intro z hz; have := h z hz; simpa [symP1] using this

theorem symP2_spec {s : Nat → Nat} {n m : Nat} (h : ∀ d, d < n → symP2 s n m d = true) :
    ∀ d, 0 < d → d < n → (m * d) % n ≠ 0 ∧ (s d = 0 ∨ s ((m * d) % n) + 1 = s d) := by
  intro d hd hdn
  have := h d hdn
  simp only [symP2, Bool.or_eq_true, beq_iff_eq, Bool.and_eq_true, bne_iff_ne, ne_eq] at this
  rcases this with h | h
  · omega
  · exact h

theorem apP_spec {χ : Nat → Nat} {n k r : Nat} (h : ∀ a, a < n → apP χ n k r a = true) :
    ∀ a, a < n → ∃ i, i < k ∧ χ ((a + i * r) % n) ≠ χ a := by
  intro a ha
  obtain ⟨i, hi, hp⟩ := anyBelow_spec (h a ha)
  exact ⟨i, hi, by simpa using hp⟩

/-- Checker for the cover condition on a small cyclic group. -/
def covOK (F : Nat → Nat → Nat) (N k t r : Nat) : Bool :=
  allBelow r (fun γ => allBelow N (fun a => allBelow N (fun d => d == 0 ||
    anyBelow k (fun i => allBelow t (fun u => F ((a + i * d) % N) u != γ)))))

theorem cov_of_ok {F : Nat → Nat → Nat} {N k t r : Nat} (hk : 0 < k)
    (hr : ∀ z u, F z u < r) (h : covOK F N k t r = true) :
    ∀ γ a d, a < N → 0 < d → d < N →
      ∃ i, i < k ∧ ∀ u, u < t → F ((a + i * d) % N) u ≠ γ := by
  intro γ a d ha hd hdN
  by_cases hγ : γ < r
  · have := allBelow_spec (allBelow_spec (allBelow_spec h γ hγ) a ha) d hdN
    simp only [Bool.or_eq_true, beq_iff_eq] at this
    rcases this with h0 | h0
    · omega
    · obtain ⟨i, hi, hp⟩ := anyBelow_spec h0
      exact ⟨i, hi, fun u hu => by have := allBelow_spec hp u hu; simpa using this⟩
  · exact ⟨0, hk, fun u _ heq => hγ (heq ▸ hr _ _)⟩

/-- Blow-up by a small cover `F` of Z/N (Blankenship–Cummings–Taranchuk type step). -/
theorem cover_step {k N M t r : Nat} (hk : 0 < k) (hN : 0 < N) (F : Nat → Nat → Nat)
    (hr : ∀ z u, F z u < r) (hinj : ∀ z u v, u < t → v < t → F z u = F z v → u = v)
    (hc : covOK F N k t r = true) (h : VdWGt t k M) : VdWGt r k (N * M) := by
  obtain ⟨ψ, hψt, hψ⟩ := h
  exact ⟨_, fun _ _ => hr _ _, blowup hN F ψ hinj (cov_of_ok hk hr hc) hψ hψt⟩

/-- `F z u = (z % r + 1 + u) % r` : colour `z % r` is the one colour missing at `z`. -/
def missF (r : Nat) (z u : Nat) : Nat := (z % r + 1 + u) % r

theorem missF_lt {r : Nat} (hr : 0 < r) (z u : Nat) : missF r z u < r := Nat.mod_lt _ hr

theorem missF_inj {r : Nat} (hr : 0 < r)
    (hdec : ∀ w, w < r → ∀ u, u < r - 1 → ∀ v, v < r - 1 →
      (w + 1 + u) % r = (w + 1 + v) % r → u = v) :
    ∀ z u v, u < r - 1 → v < r - 1 → missF r z u = missF r z v → u = v :=
  fun z u v hu hv h => hdec (z % r) (Nat.mod_lt _ hr) u hu v hv h

