def okD (d n : Int) : Bool := decide (d ≤ 0) || decide (4 * (d * d) ≤ n * 8)
def k3B (r : List Int) : Bool :=
  (octBlocks.all (fun b => b.2.all (fun m => okD (dotOct r (posList b.1) m) (dot r r)))) &&
  rootData.all (fun q => okD (q.2.2.1 * r.getD q.1 0 + q.2.2.2 * r.getD q.2.1 0) (dot r r))
def k4B (r : List Int) : Bool :=
  reps.all (fun r2 => grpM.all (fun gm => (decide (gm = 0) && decide (r2 = r)) || compatB r (sgn (vecOf (signF gm)) r2)))
def rrB (r : Nat × Nat × Int × Int) : Bool :=
  rootData.all (fun r2 => decide (r = r2) ||
    decide (r.2.2.1 * rootF r2.1 r2.2.1 r2.2.2.1 r2.2.2.2 r.1 + r.2.2.2 * rootF r2.1 r2.2.1 r2.2.2.1 r2.2.2.2 r.2.1 ≤ 4))


