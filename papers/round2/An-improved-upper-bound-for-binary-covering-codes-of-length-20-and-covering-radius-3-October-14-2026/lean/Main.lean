import Mathlib

/-!
# A binary covering code of length 20, covering radius 3, with 1984 codewords

Main theorem (`KTwentyThree.main`):

  there is a set `C` of binary words of length 20 (functions `Fin 20 → Fin 2`) with
  `C.card ≤ 1984` such that every word `x` is within Hamming distance 3 of some `c ∈ C`;
  i.e. `K(20,3) ≤ 1984`.

`hammingDist` is Mathlib's Hamming distance: the number of coordinates in which two words differ.

Construction: amalgamated direct sum of the [7,4] Hamming code `A` and a normal binary code `B`
of length 14, covering radius 2 and 248 words. All finite facts are checked by the kernel
(`decide +kernel`); no `native_decide`.

Encoding used in the proof: a natural number `a < 2^n` encodes the word whose `i`-th letter is the
`i`-th binary digit of `a` (`dec n a`).
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace KTwentyThree

/-! ## Encoding of words by natural numbers -/

/-- `dist k a b` = number of positions `i < k` where the `i`-th binary digits of `a` and `b` differ. -/
def dist : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 0
  | k + 1, a, b => (if a % 2 = b % 2 then 0 else 1) + dist k (a / 2) (b / 2)

/-- the word of length `n` given by the binary digits of `a` -/
def dec (n a : ℕ) : Fin n → Fin 2 := fun i => ⟨a / 2 ^ (i : ℕ) % 2, Nat.mod_lt _ (by norm_num)⟩

theorem dist_split (m : ℕ) : ∀ (k a b : ℕ), dist (m + k) a b = dist m a b + dist k (a / 2 ^ m) (b / 2 ^ m) := by
  induction m with
  | zero => intro k a b; simp [dist]
  | succ m ih =>
    intro k a b
    have h1 : m + 1 + k = (m + k) + 1 := by omega
    rw [h1, dist, dist, ih, Nat.div_div_eq_div_mul, Nat.div_div_eq_div_mul, ← pow_succ']
    omega

theorem dist_mod_left : ∀ (k a b : ℕ), dist k (a % 2 ^ k) b = dist k a b := by
  intro k
  induction k with
  | zero => intro a b; rfl
  | succ k ih =>
    intro a b
    have e1 : a % 2 ^ (k + 1) % 2 = a % 2 :=
      Nat.mod_mod_of_dvd _ (dvd_pow_self 2 (Nat.succ_ne_zero k))
    have e2 : a % 2 ^ (k + 1) / 2 = a / 2 % 2 ^ k := by
      rw [pow_succ', Nat.mod_mul_right_div_self]
    simp only [dist, e1, e2, ih]

theorem dist_comm : ∀ (k a b : ℕ), dist k a b = dist k b a := by
  intro k
  induction k with
  | zero => intro a b; rfl
  | succ k ih =>
    intro a b
    simp only [dist, ih (a / 2) (b / 2), eq_comm (a := a % 2)]

theorem dist_mod_right (k a b : ℕ) : dist k a (b % 2 ^ k) = dist k a b := by
  rw [dist_comm, dist_mod_left, dist_comm]

theorem dec_succ (n a : ℕ) (i : Fin n) : dec (n + 1) a i.succ = dec n (a / 2) i := by
  apply Fin.ext
  simp only [dec, Fin.val_succ, pow_succ', Nat.div_div_eq_div_mul]

theorem hamming_dec : ∀ (n a b : ℕ), hammingDist (dec n a) (dec n b) = dist n a b := by
  intro n
  induction n with
  | zero => intro a b; simp [hammingDist, dist]
  | succ n ih =>
    intro a b
    unfold hammingDist
    rw [Fin.card_filter_univ_succ']
    simp only [dec_succ]
    have h := ih (a / 2) (b / 2)
    unfold hammingDist at h
    rw [h, dist]
    congr 1
    have : (dec (n + 1) a 0 ≠ dec (n + 1) b 0) ↔ ¬ (a % 2 = b % 2) := by
      simp [dec, Fin.ext_iff]
    by_cases hab : a % 2 = b % 2
    · simp [hab, this]
    · simp [hab, this]

theorem dec_surj (n : ℕ) (x : Fin n → Fin 2) : ∃ a, a < 2 ^ n ∧ dec n a = x := by
  refine ⟨(finFunctionFinEquiv x : ℕ), (finFunctionFinEquiv x).isLt, ?_⟩
  funext i
  apply Fin.ext
  have h := finFunctionFinEquiv_symm_apply_val (finFunctionFinEquiv x) i
  rw [Equiv.symm_apply_apply] at h
  simp only [dec]
  exact h.symm

/-! ## The codes -/

/-- the 16 codewords of the [7,4] Hamming code (coordinate `j` has parity-check column `j+1`) -/
def Alist : List ℕ := [0, 7, 25, 30, 42, 45, 51, 52, 75, 76, 82, 85, 97, 102, 120, 127]

/-- bit mask of the code `B` (length 14, covering radius 2): `v ∈ B` iff bit `v` of `Bmask` is 1 -/
def Bmask : ℕ := 

def inB (v : ℕ) : Bool := Bmask / 2 ^ v % 2 == 1

def Blist : List ℕ := (List.range (2 ^ 14)).filter inB

/-- the amalgamated direct sum: words `u % 64 + 64 * v` with `u ∈ A`, `v ∈ B`, and the shared
coordinate (bit 6 of `u` = bit 0 of `v`) equal -/
def Clist : List ℕ :=
  Alist.flatMap (fun u => (Blist.filter (fun v => v % 2 == u / 64)).map (fun v => u % 64 + 64 * v))

theorem Blist_length : Blist.length = 248 := by decide +kernel

theorem Clist_length : Clist.length = 1984 := by decide +kernel

/-! ## Normality certificates -/

/-- normality of the Hamming code with respect to coordinate 6 -/
theorem A_norm : ∀ α, α < 128 → ∃ u0 ∈ Alist, ∃ u1 ∈ Alist,
    u0 / 64 = 0 ∧ u1 / 64 = 1 ∧ dist 7 α u0 + dist 7 α u1 ≤ 3 := by
  decide +kernel

/-- witnesses for the normality of `B` with respect to coordinate 0: for each `β < 2^14` a pair
`(v0, v1)` packed in 28 bits, 1024 pairs per chunk -/
def Wchunks : List ℕ := [
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ,
  ]

def wit (β : ℕ) : ℕ × ℕ :=
  let w := (Wchunks.getD (β / 1024) 0) / 2 ^ (28 * (β % 1024)) % 2 ^ 28
  (w % 2 ^ 14, w / 2 ^ 14)

def chkPair (β v0 v1 : ℕ) : Bool :=
  inB v0 && inB v1 && v0 % 2 == 0 && v1 % 2 == 1 &&
    decide (v0 < 2 ^ 14) && decide (v1 < 2 ^ 14) && decide (dist 14 β v0 + dist 14 β v1 ≤ 5)

def chkB (β : ℕ) : Bool := chkPair β (wit β).1 (wit β).2

/-- `allBelow f n = true` iff `f i = true` for all `i < n` (tail-recursive checker) -/
def allBelow (f : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n + 1 => f n && allBelow f n

theorem allBelow_spec (f : ℕ → Bool) : ∀ n, allBelow f n = true → ∀ i, i < n → f i = true := by
  intro n
  induction n with
  | zero => intro _ i hi; omega
  | succ n ih =>
    intro h i hi
    simp only [allBelow, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | hi
    · exact ih h.2 i hi
    · exact hi ▸ h.1

theorem chkB_allBelow : allBelow chkB (2 ^ 14) = true := by
  decide +kernel

theorem chkB_all : ∀ β, β < 2 ^ 14 → chkB β = true :=
  allBelow_spec chkB _ chkB_allBelow

theorem mem_Blist (v : ℕ) : v ∈ Blist ↔ v < 2 ^ 14 ∧ inB v = true := by
  simp [Blist, List.mem_filter, List.mem_range]

/-- normality of `B` with respect to coordinate 0 -/
theorem B_norm (β : ℕ) (hβ : β < 2 ^ 14) : ∃ v0 ∈ Blist, ∃ v1 ∈ Blist,
    v0 % 2 = 0 ∧ v1 % 2 = 1 ∧ dist 14 β v0 + dist 14 β v1 ≤ 5 := by
  have h := chkB_all β hβ
  simp only [chkB, chkPair, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩ := h
  exact ⟨(wit β).1, (mem_Blist _).2 ⟨h5, h1⟩, (wit β).2, (mem_Blist _).2 ⟨h6, h2⟩, h3, h4, h7⟩

/-! ## Covering -/

theorem key (x u v : ℕ) :
    dist 20 x (u % 64 + 64 * v) + dist 1 (x / 64) (u / 64) = dist 7 (x % 128) u + dist 14 (x / 64) v := by
  have hc1 : (u % 64 + 64 * v) / 64 = v := by omega
  have hc2 : (u % 64 + 64 * v) % 2 ^ 6 = u % 2 ^ 6 := by
    show (u % 64 + 64 * v) % 64 = u % 64
    omega
  have s20 : dist 20 x (u % 64 + 64 * v) =
      dist 6 x (u % 64 + 64 * v) + dist 14 (x / 64) ((u % 64 + 64 * v) / 64) :=
    dist_split 6 14 x (u % 64 + 64 * v)
  have s7 : dist 7 x u = dist 6 x u + dist 1 (x / 64) (u / 64) := dist_split 6 1 x u
  have m1 : dist 6 x (u % 64 + 64 * v) = dist 6 x u := by
    rw [← dist_mod_right 6 x (u % 64 + 64 * v), hc2, dist_mod_right]
  have m2 : dist 7 (x % 128) u = dist 7 x u := dist_mod_left 7 x u
  rw [s20, hc1, m1, m2, s7]
  omega

theorem dist_one (a b : ℕ) : dist 1 a b = if a % 2 = b % 2 then 0 else 1 := by
  simp [dist]

theorem cover_nat (x : ℕ) (hx : x < 2 ^ 20) : ∃ c ∈ Clist, dist 20 x c ≤ 3 := by
  have hα : x % 128 < 128 := Nat.mod_lt _ (by norm_num)
  have hβ : x / 64 < 2 ^ 14 := by
    rw [Nat.div_lt_iff_lt_mul (by norm_num)]
    norm_num at hx ⊢
    omega
  obtain ⟨u0, hu0, u1, hu1, hu0s, hu1s, hA⟩ := A_norm (x % 128) hα
  obtain ⟨v0, hv0, v1, hv1, hv0s, hv1s, hB⟩ := B_norm (x / 64) hβ
  have k0 := key x u0 v0
  have k1 := key x u1 v1
  rw [dist_one, hu0s] at k0
  rw [dist_one, hu1s] at k1
  have mem : ∀ u ∈ Alist, ∀ v ∈ Blist, v % 2 = u / 64 → u % 64 + 64 * v ∈ Clist := by
    intro u hu v hv huv
    simp only [Clist, List.mem_flatMap, List.mem_map, List.mem_filter, beq_iff_eq]
    exact ⟨u, hu, v, ⟨hv, huv⟩, rfl⟩
  by_cases hb : x / 64 % 2 = 0
  · rw [ite_eq_left (by omega)] at k0
    rw [ite_eq_right (by omega)] at k1
    by_cases h0 : dist 20 x (u0 % 64 + 64 * v0) ≤ 3
    · exact ⟨_, mem u0 hu0 v0 hv0 (by omega), h0⟩
    · exact ⟨_, mem u1 hu1 v1 hv1 (by omega), by omega⟩
  · rw [ite_eq_right (by omega)] at k0
    rw [ite_eq_left (by omega)] at k1
    by_cases h0 : dist 20 x (u0 % 64 + 64 * v0) ≤ 3
    · exact ⟨_, mem u0 hu0 v0 hv0 (by omega), h0⟩
    · exact ⟨_, mem u1 hu1 v1 hv1 (by omega), by omega⟩

/-! ## Main theorem -/

/-- **K(20,3) ≤ 1984**: there is a binary code of length 20 with at most 1984 words and
covering radius at most 3. -/
theorem main : ∃ C : Finset (Fin 20 → Fin 2), C.card ≤ 1984 ∧
    ∀ x : Fin 20 → Fin 2, ∃ c ∈ C, hammingDist x c ≤ 3 := by
  refine ⟨(Clist.map (dec 20)).toFinset, ?_, ?_⟩
  · calc (Clist.map (dec 20)).toFinset.card ≤ (Clist.map (dec 20)).length := List.toFinset_card_le _
      _ = 1984 := by rw [List.length_map, Clist_length]
  · intro x
    obtain ⟨a, ha, rfl⟩ := dec_surj 20 x
    obtain ⟨c, hc, hd⟩ := cover_nat a ha
    refine ⟨dec 20 c, ?_, ?_⟩
    · rw [List.mem_toFinset, List.mem_map]
      exact ⟨c, hc, rfl⟩
    · rw [hamming_dec]
      exact hd

/-- the auxiliary code `B` alone: a binary code of length 14, 248 words, covering radius ≤ 2
(this matches the known bound `K(14,2) ≤ 248`; `B` is moreover normal, see `B_norm`). -/
theorem codeB : ∃ C : Finset (Fin 14 → Fin 2), C.card ≤ 248 ∧
    ∀ x : Fin 14 → Fin 2, ∃ c ∈ C, hammingDist x c ≤ 2 := by
  refine ⟨(Blist.map (dec 14)).toFinset, ?_, ?_⟩
  · calc (Blist.map (dec 14)).toFinset.card ≤ (Blist.map (dec 14)).length := List.toFinset_card_le _
      _ = 248 := by rw [List.length_map, Blist_length]
  · intro x
    obtain ⟨a, ha, rfl⟩ := dec_surj 14 x
    obtain ⟨v0, hv0, v1, hv1, -, -, hB⟩ := B_norm a ha
    by_cases h : dist 14 a v0 ≤ 2
    · exact ⟨dec 14 v0, by rw [List.mem_toFinset, List.mem_map]; exact ⟨v0, hv0, rfl⟩,
        by rw [hamming_dec]; exact h⟩
    · exact ⟨dec 14 v1, by rw [List.mem_toFinset, List.mem_map]; exact ⟨v1, hv1, rfl⟩,
        by rw [hamming_dec]; omega⟩

end KTwentyThree

#print axioms KTwentyThree.main
#print axioms KTwentyThree.codeB
