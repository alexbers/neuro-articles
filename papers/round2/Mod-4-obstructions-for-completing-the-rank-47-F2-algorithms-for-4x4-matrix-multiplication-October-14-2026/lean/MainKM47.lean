import Mathlib

open Finset

namespace MM4

/-- the 4x4x4 matrix multiplication tensor over ZMod 4 (index 4*i+j) -/
def T4 (p q s : Fin 16) : ZMod 4 :=
  if p.val / 4 = s.val / 4 ∧ p.val % 4 = q.val / 4 ∧ q.val % 4 = s.val % 4 then 1 else 0

lemma split4 : ∀ z : ZMod 4, z = ((z.val % 2 : ℕ) : ZMod 4) + 2 * ((z.val / 2 : ℕ) : ZMod 4) := by
  decide

lemma expand4 : ∀ (U V W A B C : ZMod 4),
    (U + 2 * A) * (V + 2 * B) * (W + 2 * C) = U * V * W + 2 * (A * (V * W) + B * (U * W) + C * (U * V)) := by
  decide

lemma half_zero : ∀ z : ZMod 4, 2 * z = 0 → (ZMod.castHom (show 2 ∣ 4 by norm_num) (ZMod 2)) z = 0 := by
  decide

lemma swap4 {r : ℕ} (f : Fin 16 → Fin 16 → Fin 16 → Fin r → ZMod 2) :
    (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, ∑ t : Fin r, f p q s t) =
      ∑ t : Fin r, ∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, f p q s t := by
  calc (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, ∑ t : Fin r, f p q s t)
      = ∑ p : Fin 16, ∑ q : Fin 16, ∑ t : Fin r, ∑ s : Fin 16, f p q s t :=
        Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => Finset.sum_comm))
    _ = ∑ p : Fin 16, ∑ t : Fin r, ∑ q : Fin 16, ∑ s : Fin 16, f p q s t :=
        Finset.sum_congr rfl (fun p _ => Finset.sum_comm)
    _ = ∑ t : Fin r, ∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, f p q s t := Finset.sum_comm

/-- F2 core of the argument, for abstract data and abstract certificate facts. -/
theorem no_F2_solution {r nW : ℕ}
    (u v w : Fin r → Fin 16 → ℕ) (R : Fin 16 → Fin 16 → Fin 16 → ℕ)
    (ell : ℕ → Fin 16 → Fin 16 → Fin 16 → ZMod 2) (sel : (Fin 16 → ZMod 2) → ℕ)
    (F1 : ∀ i : Fin nW, (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16,
      ell i p q s * ((R p q s : ℕ) : ZMod 2)) = 1)
    (F2 : ∀ i : Fin nW, ∀ t : Fin r, ∀ p : Fin 16, (∑ q : Fin 16, ∑ s : Fin 16,
      ell i p q s * (((v t q : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))) = 0)
    (F3 : ∀ i : Fin nW, ∀ t : Fin r, ∀ q : Fin 16, (∑ p : Fin 16, ∑ s : Fin 16,
      ell i p q s * (((u t p : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))) = 0)
    (F4 : ∀ i : Fin nW, ∀ t : Fin r, ∀ s : Fin 16, (∑ p : Fin 16, ∑ q : Fin 16,
      ell i p q s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2))) = 0)
    {D : ℕ} (bvec : ℕ → Fin D → Fin 16 → ZMod 2) (coef : (Fin 16 → ZMod 2) → Fin D → ZMod 2)
    (F5a : ∀ i : Fin nW, ∀ j : Fin D, ∀ q s : Fin 16, (∑ p : Fin 16, ell i p q s * bvec i j p) = 0)
    (F5b : ∀ x : Fin 16 → ZMod 2, sel x < nW ∧ ∀ p : Fin 16, x p = ∑ j : Fin D, coef x j * bvec (sel x) j p)
    (α β γ : Fin r → Fin 16 → ZMod 2) (x : Fin 16 → ZMod 2) (M : Fin 16 → Fin 16 → ZMod 2)
    (h : ∀ p q s : Fin 16, ((R p q s : ℕ) : ZMod 2)
      + (∑ t : Fin r, (α t p * (((v t q : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))
          + β t q * (((u t p : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))
          + γ t s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2))))
      + x p * M q s = 0) : False := by
  obtain ⟨hlt, hx⟩ := F5b x
  have hcov : ∀ q s : Fin 16, (∑ p : Fin 16, ell (sel x) p q s * x p) = 0 := by
    intro q s
    have e : (∑ p : Fin 16, ell (sel x) p q s * x p) =
        ∑ j : Fin D, coef x j * ∑ p : Fin 16, ell (sel x) p q s * bvec (sel x) j p := by
      simp_rw [hx, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun p _ => by ring))
    rw [e]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    have := F5a ⟨sel x, hlt⟩ j q s
    simp only at this
    rw [this, mul_zero]
  have hR := F1 ⟨sel x, hlt⟩
  have h2 := F2 ⟨sel x, hlt⟩
  have h3 := F3 ⟨sel x, hlt⟩
  have h4 := F4 ⟨sel x, hlt⟩
  simp only [Fin.val_mk] at hR h2 h3 h4
  set i := sel x with hi
  -- the five pieces
  have pA : (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, ∑ t : Fin r,
      ell i p q s * (α t p * (((v t q : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2)))) = 0 := by
    rw [swap4]
    refine Finset.sum_eq_zero (fun t _ => ?_)
    have : ∀ p : Fin 16, (∑ q : Fin 16, ∑ s : Fin 16,
        ell i p q s * (α t p * (((v t q : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2)))) =
        α t p * ∑ q : Fin 16, ∑ s : Fin 16,
          ell i p q s * (((v t q : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2)) := by
      intro p; rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun s _ => ?_); ring
    simp only [this, h2 t, mul_zero, Finset.sum_const_zero]
  have pB : (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, ∑ t : Fin r,
      ell i p q s * (β t q * (((u t p : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2)))) = 0 := by
    rw [swap4]
    refine Finset.sum_eq_zero (fun t _ => ?_)
    rw [Finset.sum_comm]
    have : ∀ q : Fin 16, (∑ p : Fin 16, ∑ s : Fin 16,
        ell i p q s * (β t q * (((u t p : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2)))) =
        β t q * ∑ p : Fin 16, ∑ s : Fin 16,
          ell i p q s * (((u t p : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2)) := by
      intro q; rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun s _ => ?_); ring
    simp only [this, h3 t, mul_zero, Finset.sum_const_zero]
  have pC : (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, ∑ t : Fin r,
      ell i p q s * (γ t s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2)))) = 0 := by
    rw [swap4]
    refine Finset.sum_eq_zero (fun t _ => ?_)
    have e1 : (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16,
        ell i p q s * (γ t s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2)))) =
        ∑ s : Fin 16, ∑ p : Fin 16, ∑ q : Fin 16,
        ell i p q s * (γ t s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2))) := by
      calc _ = ∑ p : Fin 16, ∑ s : Fin 16, ∑ q : Fin 16,
            ell i p q s * (γ t s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2))) :=
            Finset.sum_congr rfl (fun p _ => Finset.sum_comm)
        _ = _ := Finset.sum_comm
    rw [e1]
    have : ∀ s : Fin 16, (∑ p : Fin 16, ∑ q : Fin 16,
        ell i p q s * (γ t s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2)))) =
        γ t s * ∑ p : Fin 16, ∑ q : Fin 16,
          ell i p q s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2)) := by
      intro s; rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun q _ => ?_); ring
    simp only [this, h4 t, mul_zero, Finset.sum_const_zero]
  have pX : (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, ell i p q s * (x p * M q s)) = 0 := by
    have e1 : (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, ell i p q s * (x p * M q s)) =
        ∑ q : Fin 16, ∑ s : Fin 16, ∑ p : Fin 16, ell i p q s * (x p * M q s) := by
      calc _ = ∑ q : Fin 16, ∑ p : Fin 16, ∑ s : Fin 16, ell i p q s * (x p * M q s) := Finset.sum_comm
        _ = _ := Finset.sum_congr rfl (fun q _ => Finset.sum_comm)
    rw [e1]
    refine Finset.sum_eq_zero (fun q _ => Finset.sum_eq_zero (fun s _ => ?_))
    have : (∑ p : Fin 16, ell i p q s * (x p * M q s)) = (∑ p : Fin 16, ell i p q s * x p) * M q s := by
      rw [Finset.sum_mul]; refine Finset.sum_congr rfl (fun p _ => ?_); ring
    rw [this, hcov q s, zero_mul]
  -- total
  have key : (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16, ell i p q s * (((R p q s : ℕ) : ZMod 2)
      + (∑ t : Fin r, (α t p * (((v t q : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))
          + β t q * (((u t p : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))
          + γ t s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2))))
      + x p * M q s)) = 0 := by
    refine Finset.sum_eq_zero (fun p _ => Finset.sum_eq_zero (fun q _ => Finset.sum_eq_zero (fun s _ => ?_)))
    rw [h p q s, mul_zero]
  simp only [mul_add, Finset.mul_sum, Finset.sum_add_distrib] at key
  rw [pA, pB, pC, pX] at key
  rw [hR] at key
  revert key; decide

/-- Main generic theorem: abstract data + certificate facts imply no completion over ZMod 4. -/
theorem no_Z4_completion_of_facts {r nW : ℕ}
    (u v w : Fin r → Fin 16 → ℕ) (R : Fin 16 → Fin 16 → Fin 16 → ℕ)
    (ell : ℕ → Fin 16 → Fin 16 → Fin 16 → ZMod 2) (sel : (Fin 16 → ZMod 2) → ℕ)
    (F0 : ∀ p q s : Fin 16,
      (∑ t : Fin r, ((u t p * v t q * w t s : ℕ) : ZMod 4)) = T4 p q s + 2 * ((R p q s : ℕ) : ZMod 4))
    (F1 : ∀ i : Fin nW, (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16,
      ell i p q s * ((R p q s : ℕ) : ZMod 2)) = 1)
    (F2 : ∀ i : Fin nW, ∀ t : Fin r, ∀ p : Fin 16, (∑ q : Fin 16, ∑ s : Fin 16,
      ell i p q s * (((v t q : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))) = 0)
    (F3 : ∀ i : Fin nW, ∀ t : Fin r, ∀ q : Fin 16, (∑ p : Fin 16, ∑ s : Fin 16,
      ell i p q s * (((u t p : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))) = 0)
    (F4 : ∀ i : Fin nW, ∀ t : Fin r, ∀ s : Fin 16, (∑ p : Fin 16, ∑ q : Fin 16,
      ell i p q s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2))) = 0)
    {D : ℕ} (bvec : ℕ → Fin D → Fin 16 → ZMod 2) (coef : (Fin 16 → ZMod 2) → Fin D → ZMod 2)
    (F5a : ∀ i : Fin nW, ∀ j : Fin D, ∀ q s : Fin 16, (∑ p : Fin 16, ell i p q s * bvec i j p) = 0)
    (F5b : ∀ x : Fin 16 → ZMod 2, sel x < nW ∧ ∀ p : Fin 16, x p = ∑ j : Fin D, coef x j * bvec (sel x) j p) :
    ¬ ∃ (a b c : Fin r → Fin 16 → ZMod 4) (x : Fin 16 → ZMod 4) (M : Fin 16 → Fin 16 → ZMod 4),
      (∀ t s, (a t s).val % 2 = u t s) ∧ (∀ t s, (b t s).val % 2 = v t s) ∧
      (∀ t s, (c t s).val % 2 = w t s) ∧
      ∀ p q s : Fin 16, (∑ t : Fin r, a t p * b t q * c t s) + 2 * (x p * M q s) = T4 p q s := by
  rintro ⟨a, b, c, x, M, ha, hb, hc, h⟩
  set φ := ZMod.castHom (show 2 ∣ 4 by norm_num) (ZMod 2) with hφ
  refine no_F2_solution u v w R ell sel F1 F2 F3 F4 bvec coef F5a F5b
    (fun t s => φ (((a t s).val / 2 : ℕ) : ZMod 4)) (fun t s => φ (((b t s).val / 2 : ℕ) : ZMod 4))
    (fun t s => φ (((c t s).val / 2 : ℕ) : ZMod 4)) (fun p => φ (x p)) (fun q s => φ (M q s)) ?_
  intro p q s
  have hpqs := h p q s
  have ea : ∀ t : Fin r, a t p * b t q * c t s =
      ((u t p * v t q * w t s : ℕ) : ZMod 4) + 2 * ((((a t p).val / 2 : ℕ) : ZMod 4) *
        (((v t q : ℕ) : ZMod 4) * ((w t s : ℕ) : ZMod 4))
      + (((b t q).val / 2 : ℕ) : ZMod 4) * (((u t p : ℕ) : ZMod 4) * ((w t s : ℕ) : ZMod 4))
      + (((c t s).val / 2 : ℕ) : ZMod 4) * (((u t p : ℕ) : ZMod 4) * ((v t q : ℕ) : ZMod 4))) := by
    intro t
    have ka : a t p = ((u t p : ℕ) : ZMod 4) + 2 * (((a t p).val / 2 : ℕ) : ZMod 4) := by
      rw [← ha t p]; exact split4 _
    have kb : b t q = ((v t q : ℕ) : ZMod 4) + 2 * (((b t q).val / 2 : ℕ) : ZMod 4) := by
      rw [← hb t q]; exact split4 _
    have kc : c t s = ((w t s : ℕ) : ZMod 4) + 2 * (((c t s).val / 2 : ℕ) : ZMod 4) := by
      rw [← hc t s]; exact split4 _
    conv_lhs => rw [ka, kb, kc]
    rw [expand4]
    push_cast; ring
  rw [Finset.sum_congr rfl (fun t _ => ea t), Finset.sum_add_distrib, F0 p q s, ← Finset.mul_sum] at hpqs
  have h2 : 2 * (((R p q s : ℕ) : ZMod 4) + (∑ t : Fin r, ((((a t p).val / 2 : ℕ) : ZMod 4) *
        (((v t q : ℕ) : ZMod 4) * ((w t s : ℕ) : ZMod 4))
      + (((b t q).val / 2 : ℕ) : ZMod 4) * (((u t p : ℕ) : ZMod 4) * ((w t s : ℕ) : ZMod 4))
      + (((c t s).val / 2 : ℕ) : ZMod 4) * (((u t p : ℕ) : ZMod 4) * ((v t q : ℕ) : ZMod 4))))
      + x p * M q s) = 0 := by
    have := hpqs
    linear_combination this
  have h3 := half_zero _ h2
  rw [← hφ] at h3
  simp only [map_add, map_mul, map_sum, map_natCast] at h3 ⊢
  exact h3

lemma two_mul_half (z : ZMod 4) (h : z.val % 2 = 0) : z = 2 * ((z.val / 2 : ℕ) : ZMod 4) := by
  have e := split4 z
  rw [h] at e
  simpa using e

/-- A completion statement for a rank-`r` F2 scheme implies: no rank-`(r+1)` scheme over `ZMod 4`
whose first `r` terms reduce to the F2 scheme and whose last term vanishes mod 2. -/
theorem no_rank_succ_of_no_completion {r : ℕ} (u v w : Fin r → Fin 16 → ℕ)
    (H : ¬ ∃ (a b c : Fin r → Fin 16 → ZMod 4) (x : Fin 16 → ZMod 4) (M : Fin 16 → Fin 16 → ZMod 4),
      (∀ t s, (a t s).val % 2 = u t s) ∧ (∀ t s, (b t s).val % 2 = v t s) ∧
      (∀ t s, (c t s).val % 2 = w t s) ∧
      ∀ p q s : Fin 16, (∑ t : Fin r, a t p * b t q * c t s) + 2 * (x p * M q s) = T4 p q s) :
    ¬ ∃ (a b c : Fin (r + 1) → Fin 16 → ZMod 4),
      (∀ (t : Fin r) s, (a t.castSucc s).val % 2 = u t s) ∧
      (∀ (t : Fin r) s, (b t.castSucc s).val % 2 = v t s) ∧
      (∀ (t : Fin r) s, (c t.castSucc s).val % 2 = w t s) ∧
      ((∀ s, (a (Fin.last r) s).val % 2 = 0) ∨ (∀ s, (b (Fin.last r) s).val % 2 = 0) ∨
        (∀ s, (c (Fin.last r) s).val % 2 = 0)) ∧
      ∀ p q s : Fin 16, (∑ t : Fin (r + 1), a t p * b t q * c t s) = T4 p q s := by
  rintro ⟨a, b, c, ha, hb, hc, hlast, h⟩
  apply H
  rcases hlast with hl | hl | hl
  · refine ⟨fun t => a t.castSucc, fun t => b t.castSucc, fun t => c t.castSucc,
      fun s => (((a (Fin.last r) s).val / 2 : ℕ) : ZMod 4),
      fun q s => b (Fin.last r) q * c (Fin.last r) s, ha, hb, hc, ?_⟩
    intro p q s
    have e := h p q s
    rw [Fin.sum_univ_castSucc, two_mul_half _ (hl p)] at e
    linear_combination e
  · refine ⟨fun t => a t.castSucc, fun t => b t.castSucc, fun t => c t.castSucc,
      fun p => a (Fin.last r) p,
      fun q s => (((b (Fin.last r) q).val / 2 : ℕ) : ZMod 4) * c (Fin.last r) s, ha, hb, hc, ?_⟩
    intro p q s
    have e := h p q s
    rw [Fin.sum_univ_castSucc, two_mul_half (b (Fin.last r) q) (hl q)] at e
    linear_combination e
  · refine ⟨fun t => a t.castSucc, fun t => b t.castSucc, fun t => c t.castSucc,
      fun p => a (Fin.last r) p,
      fun q s => b (Fin.last r) q * (((c (Fin.last r) s).val / 2 : ℕ) : ZMod 4), ha, hb, hc, ?_⟩
    intro p q s
    have e := h p q s
    rw [Fin.sum_univ_castSucc, two_mul_half (c (Fin.last r) s) (hl s)] at e
    linear_combination e

end MM4


/-!
# Certificate for the F2 scheme `KM47` (rank 47) of 4x4 matrix multiplication

Index convention: `s = 4*i + j` for entry (i,j) of a 4x4 matrix; a term `a (x) b (x) c` contributes
`a[4i+j] * b[4j'+k] * c[4i'+k']` at `(4i+j, 4j'+k, 4i'+k')`; `MM4.T4` is 1 iff i=i', j=j', k=k'.
The witness facts F1-F5 are finite computations checked with `native_decide`.
-/

namespace KM47

def hexVal (c : Char) : ℕ := if c.isDigit then c.toNat - '0'.toNat else c.toNat - 'a'.toNat + 10
def parseHex (s : String) : ℕ := s.foldl (fun acc c => acc * 16 + hexVal c) 0
def parseList (s : String) : Array ℕ := ((s.splitOn ",").map parseHex).toArray

/-- the F2 scheme: bit `s` of `uM[t]` is the coefficient `u_t[s]` -/
def uM : Array ℕ := #[8, 28744, 53248, 1033, 39072, 24576, 1024, 345, 21514, 39104, 20480, 2048, 1802, 1849, 73, 28750, 21002, 2128, 1887, 3328, 63648, 13322, 13, 36864, 20488, 1952, 1792, 80, 9, 6, 37888, 96, 28832, 22528, 10, 28712, 40608, 160, 36928, 4168, 1881, 208, 88, 28682, 1536, 28672, 64]
def vM : Array ℕ := #[60910, 28006, 14515, 771, 25273, 28086, 3795, 514, 3536, 45753, 15843, 49683, 528, 521, 776, 2816, 544, 4627, 512, 531, 37561, 2992, 768, 26803, 12339, 537, 543, 4638, 782, 3328, 2227, 25193, 37401, 12819, 3552, 37529, 697, 25113, 47283, 45243, 527, 4633, 4625, 2944, 735, 28134, 25966]
def wM : Array ℕ := #[61672, 61676, 36864, 3846, 31840, 16384, 23046, 3840, 24070, 96, 7686, 30816, 3591, 80, 92, 12, 3584, 3936, 7, 2304, 28672, 20480, 9, 15456, 61446, 3152, 2903, 3863, 3923, 4, 23552, 64, 28896, 32256, 24066, 224, 3072, 31776, 61536, 61440, 3927, 144, 231, 20492, 1024, 45292, 61612]
def u (t : Fin 47) (s : Fin 16) : ℕ := if (uM.getD t.val 0).testBit s.val then 1 else 0
def v (t : Fin 47) (s : Fin 16) : ℕ := if (vM.getD t.val 0).testBit s.val then 1 else 0
def w (t : Fin 47) (s : Fin 16) : ℕ := if (wM.getD t.val 0).testBit s.val then 1 else 0

/-- first-order obstruction: `sum_t u v w = T4 + 2 R` over ZMod 4 -/
def RN : ℕ := 
def R (p q s : Fin 16) : ℕ := if RN.testBit (p.val * 256 + q.val * 16 + s.val) then 1 else 0

set_option maxRecDepth 100000 in
theorem F0 : ∀ p q s : Fin 16,
