def enc (x : Fin 16 → ZMod 2) : ℕ := ∑ p : Fin 16, (x p).val * 2 ^ p.val
def sel (x : Fin 16 → ZMod 2) : ℕ := selT.getD (enc x) 0
def coef (x : Fin 16 → ZMod 2) (j : Fin 7) : ZMod 2 := if (coefT.getD (enc x) 0).testBit j.val then 1 else 0

lemma conv2 (f : Fin 16 → Fin 16 → ZMod 2) (a b : Fin 16 → ℕ)
    (ha : ∀ q, a q = 0 ∨ a q = 1) (hb : ∀ s, b s = 0 ∨ b s = 1) :
    (∑ q : Fin 16, ∑ s : Fin 16, f q s * (((a q : ℕ) : ZMod 2) * ((b s : ℕ) : ZMod 2))) =
      ∑ q ∈ Finset.univ.filter (fun q => a q = 1), ∑ s ∈ Finset.univ.filter (fun s => b s = 1), f q s := by
  rw [Finset.sum_filter]
  refine Finset.sum_congr rfl (fun q _ => ?_)
  rw [Finset.sum_filter]
  rcases ha q with h | h
  · simp [h]
  · simp only [h, if_true, Nat.cast_one, one_mul]
    refine Finset.sum_congr rfl (fun s _ => ?_)
    rcases hb s with h' | h' <;> simp [h']

lemma conv1 (f : Fin 16 → ZMod 2) (g : Fin 16 → ZMod 2) (hg : ∀ p, g p = 0 ∨ g p = 1) :
    (∑ p : Fin 16, f p * g p) = ∑ p ∈ Finset.univ.filter (fun p => g p = 1), f p := by
  rw [Finset.sum_filter]
  refine Finset.sum_congr rfl (fun p _ => ?_)
  rcases hg p with h | h <;> simp [h]

lemma u01 (t : Fin 47) (s : Fin 16) : u t s = 0 ∨ u t s = 1 := by unfold u; split <;> simp
lemma v01 (t : Fin 47) (s : Fin 16) : v t s = 0 ∨ v t s = 1 := by unfold v; split <;> simp
lemma w01 (t : Fin 47) (s : Fin 16) : w t s = 0 ∨ w t s = 1 := by unfold w; split <;> simp
lemma b01 (i : ℕ) (j : Fin 7) (p : Fin 16) : bvec i j p = 0 ∨ bvec i j p = 1 := by unfold bvec; split <;> simp

def P1 (i : Fin 1581) : Prop := (∑ p : Fin 16, ∑ q : Fin 16, ∑ s : Fin 16,
    ell i p q s * ((R p q s : ℕ) : ZMod 2)) = 1
def P2 (i : Fin 1581) : Prop := ∀ t : Fin 47, ∀ p : Fin 16,
    (∑ q ∈ Finset.univ.filter (fun q => v t q = 1), ∑ s ∈ Finset.univ.filter (fun s => w t s = 1), ell i p q s) = 0
def P3 (i : Fin 1581) : Prop := ∀ t : Fin 47, ∀ q : Fin 16,
    (∑ p ∈ Finset.univ.filter (fun p => u t p = 1), ∑ s ∈ Finset.univ.filter (fun s => w t s = 1), ell i p q s) = 0
def P4 (i : Fin 1581) : Prop := ∀ t : Fin 47, ∀ s : Fin 16,
    (∑ p ∈ Finset.univ.filter (fun p => u t p = 1), ∑ q ∈ Finset.univ.filter (fun q => v t q = 1), ell i p q s) = 0
def P5 (i : Fin 1581) : Prop := ∀ j : Fin 7, ∀ q s : Fin 16,
    (∑ p ∈ Finset.univ.filter (fun p => bvec i j p = 1), ell i p q s) = 0

instance (i : Fin 1581) : Decidable (P1 i) := by unfold P1; infer_instance
instance (i : Fin 1581) : Decidable (P2 i) := by unfold P2; infer_instance
instance (i : Fin 1581) : Decidable (P3 i) := by unfold P3; infer_instance
instance (i : Fin 1581) : Decidable (P4 i) := by unfold P4; infer_instance
instance (i : Fin 1581) : Decidable (P5 i) := by unfold P5; infer_instance

theorem F1_all : ∀ i : Fin 1581, P1 i := by native_decide

theorem F2_all : ∀ i : Fin 1581, P2 i := by native_decide

theorem F3_all : ∀ i : Fin 1581, P3 i := by native_decide

theorem F4_all : ∀ i : Fin 1581, P4 i := by native_decide

theorem F5a_all : ∀ i : Fin 1581, P5 i := by native_decide

theorem F2full : ∀ i : Fin 1581, ∀ t : Fin 47, ∀ p : Fin 16, (∑ q : Fin 16, ∑ s : Fin 16,
    ell i p q s * (((v t q : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))) = 0 := by
  intro i t p
  rw [conv2 (fun q s => ell i p q s) (v t) (w t) (v01 t) (w01 t)]
  exact F2_all i t p
theorem F3full : ∀ i : Fin 1581, ∀ t : Fin 47, ∀ q : Fin 16, (∑ p : Fin 16, ∑ s : Fin 16,
    ell i p q s * (((u t p : ℕ) : ZMod 2) * ((w t s : ℕ) : ZMod 2))) = 0 := by
  intro i t q
  rw [conv2 (fun p s => ell i p q s) (u t) (w t) (u01 t) (w01 t)]
  exact F3_all i t q
theorem F4full : ∀ i : Fin 1581, ∀ t : Fin 47, ∀ s : Fin 16, (∑ p : Fin 16, ∑ q : Fin 16,
    ell i p q s * (((u t p : ℕ) : ZMod 2) * ((v t q : ℕ) : ZMod 2))) = 0 := by
  intro i t s
  rw [conv2 (fun p q => ell i p q s) (u t) (v t) (u01 t) (v01 t)]
  exact F4_all i t s
theorem F5full : ∀ i : Fin 1581, ∀ j : Fin 7, ∀ q s : Fin 16, (∑ p : Fin 16, ell i p q s * bvec i j p) = 0 := by
  intro i j q s
  rw [conv1 (fun p => ell i p q s) (bvec i j) (b01 i j)]
  exact F5a_all i j q s
theorem F5b : ∀ x : Fin 16 → ZMod 2, sel x < 1581 ∧
    ∀ p : Fin 16, x p = ∑ j : Fin 7, coef x j * bvec (sel x) j p := by native_decide

/-- **Main theorem.** The F2 scheme `KM47` admits no completion over `ZMod 4` by a term divisible by 2:
there are no `a b c` reducing mod 2 to `u v w` and no `x`, `M` with
`∑ t, a_t ⊗ b_t ⊗ c_t + 2 • (x ⊗ M) = T4` (the 4x4x4 matrix multiplication tensor). -/
theorem no_Z4_completion :
    ¬ ∃ (a b c : Fin 47 → Fin 16 → ZMod 4) (x : Fin 16 → ZMod 4) (M : Fin 16 → Fin 16 → ZMod 4),
      (∀ t s, (a t s).val % 2 = u t s) ∧ (∀ t s, (b t s).val % 2 = v t s) ∧
      (∀ t s, (c t s).val % 2 = w t s) ∧
      ∀ p q s : Fin 16, (∑ t : Fin 47, a t p * b t q * c t s) + 2 * (x p * M q s) = MM4.T4 p q s :=
  MM4.no_Z4_completion_of_facts u v w R ell sel F0 F1_all F2full F3full F4full bvec coef F5full F5b

/-- **Corollary.** No rank-48 scheme over `ZMod 4` whose first 47 terms reduce mod 2 to `KM47` and whose
last term vanishes mod 2 (one of its three factors is divisible by 2). -/
theorem no_rank48 :
    ¬ ∃ (a b c : Fin (47 + 1) → Fin 16 → ZMod 4),
      (∀ (t : Fin 47) s, (a t.castSucc s).val % 2 = u t s) ∧
      (∀ (t : Fin 47) s, (b t.castSucc s).val % 2 = v t s) ∧
      (∀ (t : Fin 47) s, (c t.castSucc s).val % 2 = w t s) ∧
      ((∀ s, (a (Fin.last 47) s).val % 2 = 0) ∨ (∀ s, (b (Fin.last 47) s).val % 2 = 0) ∨
        (∀ s, (c (Fin.last 47) s).val % 2 = 0)) ∧
      ∀ p q s : Fin 16, (∑ t : Fin (47 + 1), a t p * b t q * c t s) = MM4.T4 p q s :=
  MM4.no_rank_succ_of_no_completion u v w no_Z4_completion

end KM47

