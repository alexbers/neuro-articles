import Mathlib

/-!
# Library for certified upper bounds on the first autocorrelation constant

Part 1 (Kronecker substitution): the autoconvolution of a packed integer sequence is read off the
base-`2^w` digits of a single big-integer square, which the Lean kernel computes with GMP.
Part 2 (step functions): for a nonnegative step function `f` with `n` equal steps on `[-1/4,1/4]`,
`∫ f = (1/2n) ∑ a i` and `(f*f)(t) ≤ (1/2n) max_k ∑_{i+j=k} a i a j` for every real `t`.
-/

open Finset Polynomial MeasureTheory Set

namespace Autoconv


/-- `k`-th coefficient of the (discrete) autoconvolution of `a : ℕ → ℕ`. -/
def conv (a : ℕ → ℕ) (k : ℕ) : ℕ := ∑ p ∈ antidiagonal k, a p.1 * a p.2

/-- `k`-th coefficient of the product of the generating polynomials of `a` and `c`. -/
def mulCoeff (a c : ℕ → ℕ) (k : ℕ) : ℕ := ∑ p ∈ antidiagonal k, a p.1 * c p.2

/-- `k`-th digit of `N` in base `b`. -/
def dig (b N k : ℕ) : ℕ := N / b ^ k % b

lemma dig_succ (b N k : ℕ) : dig b N (k + 1) = dig b (N / b) k := by
  unfold dig
  rw [pow_succ', Nat.div_div_eq_div_mul]

/-- Digits of `∑ c j * b ^ j` are the `c j` when all `c j < b`. -/
lemma dig_sum (b : ℕ) (hb : 1 < b) : ∀ (m : ℕ) (c : ℕ → ℕ), (∀ j < m, c j < b) →
    ∀ k, k < m → dig b (∑ j ∈ range m, c j * b ^ j) k = c k := by
  intro m
  induction m with
  | zero => intro c _ k hk; omega
  | succ m ih =>
    intro c hc k hk
    have hsplit : ∑ j ∈ range (m + 1), c j * b ^ j
        = c 0 + b * ∑ j ∈ range m, c (j + 1) * b ^ j := by
      rw [Finset.sum_range_succ', Finset.mul_sum]
      simp only [pow_zero, mul_one]
      rw [add_comm]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      ring
    have hb0 : 0 < b := by omega
    have hc0 : c 0 < b := hc 0 (by omega)
    rw [hsplit]
    cases k with
    | zero =>
      unfold dig
      simp only [pow_zero, Nat.div_one]
      rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hc0]
    | succ k =>
      rw [dig_succ]
      have : (c 0 + b * ∑ j ∈ range m, c (j + 1) * b ^ j) / b
          = ∑ j ∈ range m, c (j + 1) * b ^ j := by
        rw [Nat.add_mul_div_left _ _ hb0, Nat.div_eq_of_lt hc0, zero_add]
      rw [this]
      exact ih (fun j => c (j + 1)) (fun j hj => hc (j + 1) (by omega)) k (by omega)

/-- A number below `b ^ n` is the sum of its first `n` digits. -/
lemma eq_sum_dig (b : ℕ) (hb : 1 < b) : ∀ (n N : ℕ), N < b ^ n →
    N = ∑ i ∈ range n, dig b N i * b ^ i := by
  intro n
  induction n with
  | zero => intro N hN; simp at hN; simp [hN]
  | succ n ih =>
    intro N hN
    have hb0 : 0 < b := by omega
    have h1 : N / b < b ^ n := by
      rw [Nat.div_lt_iff_lt_mul hb0, ← pow_succ]; exact hN
    rw [Finset.sum_range_succ']
    simp only [pow_zero, mul_one]
    have h2 : ∑ i ∈ range n, dig b N (i + 1) * b ^ (i + 1)
        = b * ∑ i ∈ range n, dig b (N / b) i * b ^ i := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [dig_succ]; ring
    rw [h2, ← ih (N / b) h1]
    unfold dig
    simp only [pow_zero, Nat.div_one]
    have := Nat.div_add_mod N b
    omega

/-- Generating polynomial of the first `n` terms of `a`. -/
noncomputable def gen (n : ℕ) (a : ℕ → ℕ) : ℕ[X] := ∑ i ∈ range n, C (a i) * X ^ i

lemma gen_coeff (n : ℕ) (a : ℕ → ℕ) (ha : ∀ i, n ≤ i → a i = 0) (k : ℕ) :
    (gen n a).coeff k = a k := by
  unfold gen
  rw [Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul_X_pow]
  rw [Finset.sum_ite_eq]
  split_ifs with h
  · rfl
  · simp at h; exact (ha k h).symm

lemma gen_eval (n : ℕ) (a : ℕ → ℕ) (x : ℕ) :
    (gen n a).eval x = ∑ i ∈ range n, a i * x ^ i := by
  unfold gen
  simp [Polynomial.eval_finsetSum]

/-- Kronecker substitution: product of two packed sequences. -/
lemma packed_mul (n : ℕ) (a c : ℕ → ℕ) (ha : ∀ i, n ≤ i → a i = 0)
    (hc : ∀ i, n ≤ i → c i = 0) (x : ℕ) :
    (∑ i ∈ range n, a i * x ^ i) * (∑ i ∈ range n, c i * x ^ i)
      = ∑ k ∈ range (2 * n), mulCoeff a c k * x ^ k := by
  rw [← gen_eval, ← gen_eval, ← Polynomial.eval_mul]
  have hcoeff : ∀ k, (gen n a * gen n c).coeff k = mulCoeff a c k := by
    intro k
    rw [Polynomial.coeff_mul]
    unfold mulCoeff
    apply Finset.sum_congr rfl
    intro p _
    rw [gen_coeff n a ha, gen_coeff n c hc]
  have hdeg : (gen n a * gen n c).natDegree < 2 * n ∨ n = 0 := by
    rcases Nat.eq_zero_or_pos n with h | h
    · right; exact h
    left
    have : (gen n a * gen n c).natDegree ≤ 2 * n - 1 := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      rw [hcoeff]
      unfold mulCoeff
      apply Finset.sum_eq_zero
      intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      have hN' : (2 * n - 1 : ℕ) < N := by exact_mod_cast hN
      rcases Nat.lt_or_ge p.1 n with h1 | h1
      · rw [hc p.2 (by omega), mul_zero]
      · rw [ha p.1 h1, zero_mul]
    omega
  rcases hdeg with hdeg | hn
  · rw [Polynomial.eval_eq_sum_range' hdeg]
    apply Finset.sum_congr rfl
    intro k _
    rw [hcoeff]
  · subst hn
    have h0 : gen 0 a = 0 := by simp [gen]
    simp [h0, mulCoeff, ha, hc]

/-! ## Divide-and-conquer digit checks (evaluated by the kernel) -/

/-- `chkLin b M m N`: checks digit by digit that the first `m` base-`b` digits of `N` are `≤ M`. -/
def chkLin (b M : ℕ) (m : ℕ) : ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun _ ih N => Nat.ble (N % b) M && ih (N / b)) m

lemma chkLin_succ (b M m N : ℕ) :
    chkLin b M (m + 1) N = (Nat.ble (N % b) M && chkLin b M m (N / b)) := rfl

/-- `chkMax b M fuel m N`: divide-and-conquer check that the first `m` base-`b` digits of `N`
are all `≤ M` (blocks of at most 64 digits are checked by `chkLin`). -/
def chkMax (b M : ℕ) (fuel : ℕ) : ℕ → ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → ℕ → Bool) (fun _ _ => false)
    (fun _ ih m N => if m ≤ 64 then chkLin b M m N
      else ih (m / 2) (N % b ^ (m / 2)) && ih (m - m / 2) (N / b ^ (m / 2))) fuel

lemma chkMax_succ (b M fuel m N : ℕ) : chkMax b M (fuel + 1) m N =
    (if m ≤ 64 then chkLin b M m N
      else chkMax b M fuel (m / 2) (N % b ^ (m / 2)) && chkMax b M fuel (m - m / 2) (N / b ^ (m / 2))) :=
  rfl

lemma dig_mod_pow (b N k j : ℕ) (hb : 0 < b) :
    dig b (N % b ^ (k + 1 + j)) k = dig b N k := by
  unfold dig
  have hbk : 0 < b ^ k := pow_pos hb k
  have hB : b ^ (k + 1 + j) = b ^ k * (b * b ^ j) := by rw [pow_add, pow_succ]; ring
  symm
  conv_lhs => rw [← Nat.mod_add_div N (b ^ (k + 1 + j))]
  rw [hB, mul_assoc, Nat.add_mul_div_left _ _ hbk, mul_assoc, Nat.add_mul_mod_self_left]

lemma dig_div_pow (b N h k : ℕ) : dig b (N / b ^ h) k = dig b N (h + k) := by
  unfold dig
  rw [Nat.div_div_eq_div_mul, ← pow_add]

lemma chkLin_spec (b M : ℕ) : ∀ m N, chkLin b M m N = true → ∀ k < m, dig b N k ≤ M := by
  intro m
  induction m with
  | zero => intro N _ k hk; omega
  | succ m ih =>
    intro N h k hk
    rw [chkLin_succ, Bool.and_eq_true] at h
    cases k with
    | zero => unfold dig; simpa [Nat.ble_eq] using h.1
    | succ k => rw [dig_succ]; exact ih (N / b) h.2 k (by omega)

lemma chkMax_spec (b M : ℕ) (hb : 0 < b) : ∀ fuel m N, chkMax b M fuel m N = true →
    ∀ k < m, dig b N k ≤ M := by
  intro fuel
  induction fuel with
  | zero => intro m N h; simp [chkMax] at h
  | succ fuel ih =>
    intro m N h k hk
    rw [chkMax_succ] at h
    split_ifs at h with hm
    · exact chkLin_spec b M m N h k hk
    · rw [Bool.and_eq_true] at h
      rcases Nat.lt_or_ge k (m / 2) with hk2 | hk2
      · obtain ⟨j, hj⟩ : ∃ j, m / 2 = k + 1 + j := ⟨m / 2 - k - 1, by omega⟩
        have := ih _ _ h.1 k hk2
        rw [hj] at this
        rwa [dig_mod_pow b N k j hb] at this
      · have := ih _ _ h.2 (k - m / 2) (by omega)
        rw [dig_div_pow] at this
        rwa [show m / 2 + (k - m / 2) = k by omega] at this



/-- left end of the `i`-th cell -/
noncomputable def cellL (n i : ℕ) : ℝ := -1/4 + (i : ℝ) / (2 * n)

/-- the `i`-th cell `[cellL i, cellL (i+1))` -/
noncomputable def cell (n i : ℕ) : Set ℝ := Ico (cellL n i) (cellL n (i + 1))

/-- the step function with heights `a 0, …, a (n-1)` on `[-1/4, 1/4]` -/
noncomputable def stepFn (n : ℕ) (a : ℕ → ℝ) (x : ℝ) : ℝ :=
  ∑ i ∈ range n, (cell n i).indicator (fun _ => a i) x

/-- hat function -/
noncomputable def hat (u : ℝ) : ℝ := max 0 (1 - |u|)

lemma hat_nonneg (u : ℝ) : 0 ≤ hat u := le_max_left _ _

lemma hat_add_hat (u : ℝ) : hat u + hat (u - 1) ≤ 1 := by
  unfold hat
  rcases le_or_gt u 0 with h0 | h0
  · have h1 : 1 - |u - 1| ≤ 0 := by rw [abs_of_neg (by linarith)]; linarith
    rw [max_eq_left h1]
    have : max 0 (1 - |u|) ≤ 1 := max_le (by norm_num) (by linarith [abs_nonneg u])
    linarith
  rcases le_or_gt u 1 with h1 | h1
  · rw [abs_of_pos h0, abs_of_nonpos (by linarith)]
    rw [max_eq_right (by linarith), max_eq_right (by linarith)]
    linarith
  · have h2 : 1 - |u| ≤ 0 := by rw [abs_of_pos h0]; linarith
    rw [max_eq_left h2]
    have : max 0 (1 - |u - 1|) ≤ 1 := max_le (by norm_num) (by linarith [abs_nonneg (u - 1)])
    linarith

/-- Partition-of-unity bound: `∑_{k∈K} hat (s - k) ≤ 1` for any finite set of naturals. -/
lemma sum_hat_le_one (s : ℝ) (K : Finset ℕ) : ∑ k ∈ K, hat (s - k) ≤ 1 := by
  set k0 := ⌊s⌋₊
  have hsub : K.filter (fun k : ℕ => hat (s - (k : ℝ)) ≠ 0) ⊆ {k0, k0 + 1} := by
    intro k hk
    rw [Finset.mem_filter] at hk
    have hpos : |s - k| < 1 := by
      by_contra hc
      rw [not_lt] at hc
      apply hk.2
      unfold hat
      exact max_eq_left (by linarith)
    rw [abs_lt] at hpos
    simp only [Finset.mem_insert, Finset.mem_singleton]
    rcases le_or_gt 0 s with hs | hs
    · have hfl := Nat.floor_le hs
      have hfl2 := Nat.lt_floor_add_one s
      rcases le_or_gt (k : ℝ) s with hks | hks
      · left
        have h1 : k ≤ k0 := Nat.le_floor hks
        have h2 : (k0 : ℝ) < k + 1 := by linarith
        have h3 : k0 < k + 1 := by exact_mod_cast h2
        omega
      · right
        have h2 : (k : ℝ) < k0 + 2 := by linarith
        have h3 : k < k0 + 2 := by exact_mod_cast h2
        have h4 : (k0 : ℝ) < k := by linarith
        have h5 : k0 < k := by exact_mod_cast h4
        omega
    · left
      have hk0 : k0 = 0 := Nat.floor_of_nonpos hs.le
      have h2 : (k : ℝ) < 1 := by linarith
      have h3 : k < 1 := by exact_mod_cast h2
      omega
  calc ∑ k ∈ K, hat (s - k) = ∑ k ∈ K.filter (fun k : ℕ => hat (s - (k : ℝ)) ≠ 0), hat (s - k) := by
        rw [Finset.sum_filter_ne_zero]
    _ ≤ ∑ k ∈ ({k0, k0 + 1} : Finset ℕ), hat (s - k) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub (fun k _ _ => hat_nonneg _)
    _ ≤ 1 := by
        rw [Finset.sum_pair (by omega)]
        have := hat_add_hat (s - k0)
        push_cast
        have e : s - (k0 + 1 : ℝ) = s - k0 - 1 := by ring
        rw [e]; linarith


/-! ## Measure-theoretic part -/

lemma cell_width (n i : ℕ) (hn : 0 < n) : cellL n (i + 1) = cellL n i + 1 / (2 * n) := by
  unfold cellL; push_cast; ring

lemma measurableSet_cell (n i : ℕ) : MeasurableSet (cell n i) := measurableSet_Ico

lemma integrable_cell (n i : ℕ) (c : ℝ) : Integrable ((cell n i).indicator (fun _ => c)) := by
  apply IntegrableOn.integrable_indicator _ (measurableSet_cell n i)
  exact integrableOn_const measure_Ico_lt_top.ne

lemma volume_real_cell (n i : ℕ) (hn : 0 < n) : volume.real (cell n i) = 1 / (2 * n) := by
  unfold cell
  rw [Measure.real, Real.volume_Ico, cell_width n i hn]
  have hpos : (0 : ℝ) < 1 / (2 * n) := by positivity
  rw [ENNReal.toReal_ofReal (by linarith)]
  ring

lemma integrable_stepFn (n : ℕ) (a : ℕ → ℝ) : Integrable (stepFn n a) := by
  unfold stepFn
  exact integrable_finsetSum _ (fun i _ => integrable_cell n i (a i))

lemma integral_stepFn (n : ℕ) (hn : 0 < n) (a : ℕ → ℝ) :
    ∫ x, stepFn n a x = 1 / (2 * n) * ∑ i ∈ range n, a i := by
  unfold stepFn
  rw [integral_finsetSum _ (fun i _ => integrable_cell n i (a i)), Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [integral_indicator_const _ (measurableSet_cell n i), volume_real_cell n i hn, smul_eq_mul]

/-- the set of `x` with `x` in cell `i` and `t - x` in cell `j` -/
def pairSet (n i j : ℕ) (t : ℝ) : Set ℝ := cell n i ∩ {x | t - x ∈ cell n j}

lemma measurableSet_pairSet (n i j : ℕ) (t : ℝ) : MeasurableSet (pairSet n i j t) := by
  unfold pairSet
  apply (measurableSet_cell n i).inter
  have : {x : ℝ | t - x ∈ cell n j} = (fun x => t - x) ⁻¹' (cell n j) := rfl
  rw [this]
  exact (measurable_const.sub measurable_id) (measurableSet_cell n j)

lemma prod_eq_sum (n : ℕ) (a : ℕ → ℝ) (t x : ℝ) :
    stepFn n a x * stepFn n a (t - x)
      = ∑ i ∈ range n, ∑ j ∈ range n, (pairSet n i j t).indicator (fun _ => a i * a j) x := by
  unfold stepFn
  rw [Finset.sum_mul_sum]
  apply Finset.sum_congr rfl; intro i _
  apply Finset.sum_congr rfl; intro j _
  unfold pairSet
  by_cases h1 : x ∈ cell n i <;> by_cases h2 : t - x ∈ cell n j <;>
    simp [Set.indicator_apply, h1, h2]

lemma integrable_pair (n i j : ℕ) (t c : ℝ) :
    Integrable ((pairSet n i j t).indicator (fun _ => c)) := by
  apply IntegrableOn.integrable_indicator _ (measurableSet_pairSet n i j t)
  exact integrableOn_const (lt_of_le_of_lt (measure_mono Set.inter_subset_left) measure_Ico_lt_top).ne

lemma volume_real_pairSet_le (n i j : ℕ) (hn : 0 < n) (t : ℝ) :
    volume.real (pairSet n i j t)
      ≤ 1 / (2 * n) * hat ((t + 1/2) * (2 * n) - 1 - ((i + j : ℕ) : ℝ)) := by
  set h : ℝ := 1 / (2 * n) with hh
  have hpos : 0 < h := by positivity
  set D : ℝ := t - cellL n i - cellL n j - h with hD
  have hsub : pairSet n i j t ⊆ Icc (max (cellL n i) (t - cellL n j - h)) (min (cellL n i + h) (t - cellL n j)) := by
    intro x hx
    unfold pairSet cell at hx
    rw [cell_width n i hn, cell_width n j hn] at hx
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := hx
    constructor
    · exact max_le h1 (by linarith)
    · exact le_min h2.le (by linarith)
  have hvol : volume.real (pairSet n i j t) ≤ max 0 (h - |D|) := by
    have hfin : volume (Icc (max (cellL n i) (t - cellL n j - h)) (min (cellL n i + h) (t - cellL n j))) ≠ ⊤ := by
      rw [Real.volume_Icc]; exact ENNReal.ofReal_ne_top
    calc volume.real (pairSet n i j t)
        ≤ volume.real (Icc (max (cellL n i) (t - cellL n j - h)) (min (cellL n i + h) (t - cellL n j))) :=
          measureReal_mono hsub hfin
      _ = max 0 (h - |D|) := by
          rw [Measure.real, Real.volume_Icc, ENNReal.toReal_ofReal']
          rcases le_or_gt 0 D with hD0 | hD0
          · rw [abs_of_nonneg hD0]
            rw [max_eq_right (by linarith : cellL n i ≤ t - cellL n j - h)]
            rw [min_eq_left (by linarith : cellL n i + h ≤ t - cellL n j)]
            rw [max_comm]; congr 1; linarith
          · rw [abs_of_neg hD0]
            rw [max_eq_left (by linarith : t - cellL n j - h ≤ cellL n i)]
            rw [min_eq_right (by linarith : t - cellL n j ≤ cellL n i + h)]
            rw [max_comm]; congr 1; linarith
  have hD' : D / h = (t + 1/2) * (2 * n) - 1 - ((i + j : ℕ) : ℝ) := by
    rw [hD, hh]; unfold cellL; push_cast
    field_simp
    ring
  rw [← hD']
  unfold hat
  calc volume.real (pairSet n i j t) ≤ max 0 (h - |D|) := hvol
    _ = h * max 0 (1 - |D / h|) := by
        rw [abs_div, abs_of_pos hpos, mul_max_of_nonneg _ _ hpos.le]
        congr 1
        · ring
        · field_simp



lemma autoconv_le (n : ℕ) (hn : 0 < n) (A : ℕ → ℕ) (M : ℕ) (hM : ∀ k, conv A k ≤ M) (t : ℝ) :
    ∫ x, stepFn n (fun i => (A i : ℝ)) x * stepFn n (fun i => (A i : ℝ)) (t - x)
      ≤ 1 / (2 * n) * M := by
  set h : ℝ := 1 / (2 * n) with hh
  have hpos : 0 < h := by positivity
  set s : ℝ := (t + 1/2) * (2 * n) - 1 with hs
  have e1 : (fun x => stepFn n (fun i => (A i : ℝ)) x * stepFn n (fun i => (A i : ℝ)) (t - x))
      = fun x => ∑ i ∈ range n, ∑ j ∈ range n,
          (pairSet n i j t).indicator (fun _ => (A i : ℝ) * A j) x := by
    funext x; exact prod_eq_sum n _ t x
  rw [e1, integral_finsetSum _ (fun i _ => integrable_finsetSum _
      (fun j _ => integrable_pair n i j t _))]
  have e2 : ∀ i ∈ range n, ∫ x, ∑ j ∈ range n, (pairSet n i j t).indicator (fun _ => (A i : ℝ) * A j) x
      = ∑ j ∈ range n, volume.real (pairSet n i j t) * ((A i : ℝ) * A j) := by
    intro i _
    rw [integral_finsetSum _ (fun j _ => integrable_pair n i j t _)]
    apply Finset.sum_congr rfl; intro j _
    rw [integral_indicator_const _ (measurableSet_pairSet n i j t), smul_eq_mul]
  rw [Finset.sum_congr rfl e2]
  -- bound each volume by the hat function
  have e3 : ∑ i ∈ range n, ∑ j ∈ range n, volume.real (pairSet n i j t) * ((A i : ℝ) * A j)
      ≤ ∑ i ∈ range n, ∑ j ∈ range n, h * hat (s - ((i + j : ℕ) : ℝ)) * ((A i : ℝ) * A j) := by
    apply Finset.sum_le_sum; intro i _
    apply Finset.sum_le_sum; intro j _
    apply mul_le_mul_of_nonneg_right _ (by positivity)
    have := volume_real_pairSet_le n i j hn t
    rw [hs]; exact this
  refine le_trans e3 ?_
  -- regroup by k = i + j
  rw [← Finset.sum_product' (f := fun i j => h * hat (s - ((i + j : ℕ) : ℝ)) * ((A i : ℝ) * A j))]
  rw [← Finset.sum_fiberwise_of_maps_to (g := fun p : ℕ × ℕ => p.1 + p.2) (t := range (2 * n))
      (fun p hp => by
        rw [Finset.mem_product, Finset.mem_range, Finset.mem_range] at hp
        rw [Finset.mem_range]; omega)]
  have e4 : ∀ k ∈ range (2 * n),
      ∑ p ∈ (range n ×ˢ range n).filter (fun p : ℕ × ℕ => p.1 + p.2 = k),
          h * hat (s - ((p.1 + p.2 : ℕ) : ℝ)) * ((A p.1 : ℝ) * A p.2)
        ≤ h * hat (s - (k : ℝ)) * M := by
    intro k _
    have e5 : ∑ p ∈ (range n ×ˢ range n).filter (fun p : ℕ × ℕ => p.1 + p.2 = k),
          h * hat (s - ((p.1 + p.2 : ℕ) : ℝ)) * ((A p.1 : ℝ) * A p.2)
        = h * hat (s - (k : ℝ)) * ∑ p ∈ (range n ×ˢ range n).filter (fun p : ℕ × ℕ => p.1 + p.2 = k),
          ((A p.1 : ℝ) * A p.2) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro p hp
      rw [Finset.mem_filter] at hp
      rw [hp.2]
    rw [e5]
    apply mul_le_mul_of_nonneg_left _ (mul_nonneg hpos.le (hat_nonneg _))
    have hsub : (range n ×ˢ range n).filter (fun p : ℕ × ℕ => p.1 + p.2 = k) ⊆ antidiagonal k := by
      intro p hp
      rw [Finset.mem_filter] at hp
      exact Finset.HasAntidiagonal.mem_antidiagonal.2 hp.2
    calc ∑ p ∈ (range n ×ˢ range n).filter (fun p : ℕ × ℕ => p.1 + p.2 = k), ((A p.1 : ℝ) * A p.2)
        ≤ ∑ p ∈ antidiagonal k, ((A p.1 : ℝ) * A p.2) :=
          Finset.sum_le_sum_of_subset_of_nonneg hsub (fun p _ _ => by positivity)
      _ = (conv A k : ℝ) := by unfold conv; push_cast; rfl
      _ ≤ M := by exact_mod_cast hM k
  refine le_trans (Finset.sum_le_sum e4) ?_
  rw [← Finset.sum_mul, ← Finset.mul_sum]
  have hsum := sum_hat_le_one s (range (2 * n))
  have hM0 : (0 : ℝ) ≤ M := by positivity
  calc h * (∑ k ∈ range (2 * n), hat (s - (k : ℝ))) * M ≤ h * 1 * M := by gcongr
    _ = 1 / (2 * n) * M := by rw [hh]; ring


/-! ## Part 3: from a digit certificate to the continuous statement -/

lemma stepFn_nonneg (n : ℕ) (a : ℕ → ℝ) (ha : ∀ i, 0 ≤ a i) (x : ℝ) : 0 ≤ stepFn n a x := by
  unfold stepFn
  apply Finset.sum_nonneg; intro i _
  exact Set.indicator_nonneg (fun _ _ => ha i) x

lemma stepFn_support (n : ℕ) (hn : 0 < n) (a : ℕ → ℝ) (x : ℝ)
    (hx : x ∉ Set.Icc (-1/4 : ℝ) (1/4)) : stepFn n a x = 0 := by
  unfold stepFn
  apply Finset.sum_eq_zero; intro i hi
  rw [Finset.mem_range] at hi
  apply Set.indicator_of_notMem
  intro hc
  apply hx
  unfold cell cellL at hc
  obtain ⟨h1, h2⟩ := hc
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hi' : ((i : ℝ) + 1) ≤ n := by exact_mod_cast hi
  constructor
  · have : (0 : ℝ) ≤ (i : ℝ) / (2 * n) := by positivity
    linarith
  · have : ((i + 1 : ℕ) : ℝ) / (2 * n) ≤ 1 / 2 := by
      rw [div_le_iff₀ (by positivity)]; push_cast; linarith
    linarith

lemma mulCoeff_le (a c : ℕ → ℕ) (B C : ℕ) (ha : ∀ i, a i ≤ B) (hc : ∀ i, c i ≤ C) (k : ℕ) :
    mulCoeff a c k ≤ (k + 1) * (B * C) := by
  unfold mulCoeff
  calc ∑ p ∈ antidiagonal k, a p.1 * c p.2 ≤ ∑ p ∈ antidiagonal k, B * C :=
        Finset.sum_le_sum (fun p _ => Nat.mul_le_mul (ha _) (hc _))
    _ = (k + 1) * (B * C) := by
        rw [Finset.sum_const, Finset.Nat.card_antidiagonal, smul_eq_mul]

/-- The certificate theorem: kernel-checkable hypotheses imply the continuous bound. -/
theorem cert_implies (n w K fuel M S p q P : ℕ) (hn : 0 < n) (hq : 0 < q)
    (hw : 2 * n * (2 ^ K * 2 ^ K) < 2 ^ w)
    (h1 : P < (2 ^ w) ^ n)
    (h2 : chkMax (2 ^ w) (2 ^ K) fuel n P = true)
    (h3 : chkMax (2 ^ w) M fuel (2 * n) (P * P) = true)
    (h4 : dig (2 ^ w) (P * (((2 ^ w) ^ n - 1) / (2 ^ w - 1))) (n - 1) = S)
    (hS : 0 < S)
    (h5 : 2 * n * M * q ≤ p * S ^ 2) :
    ∃ f : ℝ → ℝ, (∀ x, 0 ≤ f x) ∧ (∀ x, x ∉ Set.Icc (-1/4 : ℝ) (1/4) → f x = 0) ∧
      Integrable f ∧ 0 < ∫ x, f x ∧
      ∀ t : ℝ, ∫ x, f x * f (t - x) ≤ ((p : ℝ) / q) * (∫ x, f x) ^ 2 := by
  set b := 2 ^ w with hb
  have hb1 : 1 < b := by
    have h2K : 0 < 2 ^ K := Nat.two_pow_pos K
    have : 1 ≤ 2 * n * (2 ^ K * 2 ^ K) := by
      have := Nat.mul_pos (Nat.mul_pos (by norm_num : 0 < 2) hn) (Nat.mul_pos h2K h2K)
      omega
    omega
  have hb0 : 0 < b := by omega
  set A : ℕ → ℕ := fun i => dig b P i with hA
  -- heights vanish beyond n
  have hA0 : ∀ i, n ≤ i → A i = 0 := by
    intro i hi
    simp only [hA, dig]
    have : P < b ^ i := lt_of_lt_of_le h1 (Nat.pow_le_pow_right hb0 hi)
    rw [Nat.div_eq_of_lt this, Nat.zero_mod]
  -- heights are at most 2^K
  have hAK : ∀ i, A i ≤ 2 ^ K := by
    intro i
    rcases Nat.lt_or_ge i n with hi | hi
    · exact chkMax_spec b (2 ^ K) hb0 fuel n P h2 i hi
    · rw [hA0 i hi]; exact Nat.zero_le _
  have hP : P = ∑ i ∈ range n, A i * b ^ i := eq_sum_dig b hb1 n P h1
  -- the autoconvolution coefficients are the digits of P*P
  have hPP : P * P = ∑ k ∈ range (2 * n), mulCoeff A A k * b ^ k := by
    conv_lhs => rw [hP]
    exact packed_mul n A A hA0 hA0 b
  have hconv : ∀ k, conv A k ≤ M := by
    intro k
    rcases Nat.lt_or_ge k (2 * n) with hk | hk
    · have hlt : ∀ j < 2 * n, mulCoeff A A j < b := by
        intro j hj
        have := mulCoeff_le A A (2 ^ K) (2 ^ K) hAK hAK j
        have h' : (j + 1) * (2 ^ K * 2 ^ K) ≤ 2 * n * (2 ^ K * 2 ^ K) :=
          Nat.mul_le_mul_right _ (by omega)
        omega
      have hd : dig b (P * P) k = mulCoeff A A k := by
        rw [hPP]; exact dig_sum b hb1 (2 * n) (mulCoeff A A) hlt k hk
      have := chkMax_spec b M hb0 fuel (2 * n) (P * P) h3 k hk
      rw [hd] at this
      exact this
    · have : conv A k = 0 := by
        unfold conv
        apply Finset.sum_eq_zero
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        rcases Nat.lt_or_ge p.1 n with h | h
        · rw [hA0 p.2 (by omega), mul_zero]
        · rw [hA0 p.1 h, zero_mul]
      rw [this]; exact Nat.zero_le _
  -- the sum of the heights
  set c : ℕ → ℕ := fun i => if i < n then 1 else 0 with hc
  have hc0 : ∀ i, n ≤ i → c i = 0 := by intro i hi; simp [hc]; omega
  have hc1 : ∀ i, c i ≤ 1 := by intro i; simp only [hc]; split_ifs <;> omega
  have hQ : ((b ^ n - 1) / (b - 1)) = ∑ i ∈ range n, c i * b ^ i := by
    have hg := geom_sum_mul_add (b - 1) n
    rw [Nat.sub_add_cancel (by omega : 1 ≤ b)] at hg
    have e : ∑ i ∈ range n, c i * b ^ i = ∑ i ∈ range n, b ^ i := by
      apply Finset.sum_congr rfl; intro i hi; rw [Finset.mem_range] at hi; simp [hc, hi]
    rw [e]
    have hb1' : 0 < b - 1 := by omega
    rw [← hg, Nat.add_sub_cancel, Nat.mul_div_cancel _ hb1']
  have hPQ : P * ((b ^ n - 1) / (b - 1)) = ∑ k ∈ range (2 * n), mulCoeff A c k * b ^ k := by
    rw [hQ]; conv_lhs => rw [hP]
    exact packed_mul n A c hA0 hc0 b
  have hsumA : ∑ i ∈ range n, A i = S := by
    have hlt : ∀ j < 2 * n, mulCoeff A c j < b := by
      intro j hj
      have := mulCoeff_le A c (2 ^ K) 1 hAK hc1 j
      have h' : (j + 1) * (2 ^ K * 1) ≤ 2 * n * (2 ^ K * 2 ^ K) := by
        apply Nat.mul_le_mul (by omega)
        exact Nat.mul_le_mul_left _ (Nat.one_le_two_pow)
      omega
    have hd : dig b (P * ((b ^ n - 1) / (b - 1))) (n - 1) = mulCoeff A c (n - 1) := by
      rw [hPQ]; exact dig_sum b hb1 (2 * n) (mulCoeff A c) hlt (n - 1) (by omega)
    rw [← h4, hd]
    unfold mulCoeff
    rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ (fun i j => A i * c j) (n - 1)]
    rw [show (n - 1).succ = n by omega]
    apply Finset.sum_congr rfl
    intro i hi
    rw [Finset.mem_range] at hi
    simp [hc]; omega
  -- the continuous statement
  refine ⟨stepFn n (fun i => (A i : ℝ)), ?_, ?_, ?_, ?_, ?_⟩
  · exact stepFn_nonneg n _ (fun i => by positivity)
  · exact stepFn_support n hn _
  · exact integrable_stepFn n _
  · rw [integral_stepFn n hn]
    have : (0 : ℝ) < ∑ i ∈ range n, (A i : ℝ) := by
      rw [← Nat.cast_sum, hsumA]; exact_mod_cast hS
    positivity
  · intro t
    have hle := autoconv_le n hn A M hconv t
    refine le_trans hle ?_
    rw [integral_stepFn n hn, ← Nat.cast_sum, hsumA]
    have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    have hq' : (0 : ℝ) < q := by exact_mod_cast hq
    have h5' : (2 * n * M * q : ℝ) ≤ p * S ^ 2 := by exact_mod_cast h5
    have e : (p : ℝ) / q * (1 / (2 * n) * S) ^ 2 - 1 / (2 * n) * M
        = (p * S ^ 2 - 2 * n * M * q) / (4 * n ^ 2 * q) := by
      field_simp; ring
    rw [← sub_nonneg, e]
    apply div_nonneg (by linarith) (by positivity)

end Autoconv

