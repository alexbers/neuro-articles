open MeasureTheory in
/-- A function is *admissible* for the first autocorrelation inequality if it is nonnegative,
vanishes outside `[-1/4, 1/4]`, is integrable and has positive integral. -/
def AutocorrAdmissible (f : ℝ → ℝ) : Prop :=
  (∀ x, 0 ≤ f x) ∧ (∀ x, x ∉ Set.Icc (-1/4 : ℝ) (1/4) → f x = 0) ∧ Integrable f ∧ 0 < ∫ x, f x

open MeasureTheory in
/-- The first autocorrelation constant
`C₁ = inf { c : some admissible f has (f*f)(t) ≤ c (∫ f)² for all t }`,
i.e. `C₁ = inf_f sup_t (f*f)(t) / (∫ f)²`, where `(f*f)(t) = ∫ f(x) f(t-x) dx`. -/
noncomputable def C₁ : ℝ :=
  sInf {c : ℝ | ∃ f : ℝ → ℝ, AutocorrAdmissible f ∧ ∀ t : ℝ, ∫ x, f x * f (t - x) ≤ c * (∫ x, f x) ^ 2}

open MeasureTheory in
/-- **Main theorem (explicit witness).** There is an admissible `f` with
`(f*f)(t) ≤ (15027434864131 / 10000000000000) (∫ f)²` for every real `t`. -/
theorem first_autocorrelation_upper_bound :
    ∃ f : ℝ → ℝ, (∀ x, 0 ≤ f x) ∧ (∀ x, x ∉ Set.Icc (-1/4 : ℝ) (1/4) → f x = 0) ∧
      Integrable f ∧ 0 < ∫ x, f x ∧
      ∀ t : ℝ, ∫ x, f x * f (t - x) ≤ ((15027434864131 : ℝ) / 10000000000000) * (∫ x, f x) ^ 2 :=
  Autoconv.cert_implies 65536 104 40 40 13410726954545060822249944 1081530312684219 15027434864131 10000000000000 Autoconv.Cert.P (by norm_num) (by norm_num)
    (by norm_num) Autoconv.Cert.h1 Autoconv.Cert.h2 Autoconv.Cert.h3 Autoconv.Cert.h4
    (by norm_num) (by norm_num)

open MeasureTheory in
/-- **Main theorem.** `C₁ ≤ 15027434864131 / 10000000000000`. -/
theorem C₁_le : C₁ ≤ (15027434864131 : ℝ) / 10000000000000 := by
  obtain ⟨f, h0, h1, h2, h3, h4⟩ := first_autocorrelation_upper_bound
  apply csInf_le
  · refine ⟨0, fun c hc => ?_⟩
    obtain ⟨g, ⟨g0, -, -, g3⟩, hg⟩ := hc
    have hpos : 0 < (∫ x, g x) ^ 2 := by positivity
    have hnn : 0 ≤ ∫ x, g x * g (0 - x) := integral_nonneg (fun x => mul_nonneg (g0 x) (g0 _))
    have := le_trans hnn (hg 0)
    by_contra hneg
    rw [not_le] at hneg
    have : c * (∫ x, g x) ^ 2 < 0 := mul_neg_of_neg_of_pos hneg hpos
    linarith
  · exact ⟨f, ⟨h0, h1, h2, h3⟩, h4⟩

