  | c :: cs => c.natAbs + sumAbs cs

lemma getD_abs_le_sumAbs : ∀ (p : List ℤ) (k : ℕ), |p.getD k 0| ≤ (sumAbs p : ℤ)
  | [], k => by simp [sumAbs]
  | c :: cs, k => by
      have hc : |c| = ((c.natAbs : ℕ) : ℤ) := Int.abs_eq_natAbs c
      have hs : (0 : ℤ) ≤ (sumAbs cs : ℤ) := by positivity
      rcases k with _ | k
      · simp only [List.getD_cons_zero, sumAbs]; push_cast; rw [hc]; linarith
      · simp only [List.getD_cons_succ, sumAbs]; push_cast
        have := getD_abs_le_sumAbs cs k
        have : (0 : ℤ) ≤ ((c.natAbs : ℕ) : ℤ) := by positivity
        linarith

lemma ev_eq_sum : ∀ (p : List ℤ) (x : ℝ), ev p x = ∑ j ∈ Finset.range p.length, (p.getD j 0 : ℝ) * x ^ j
