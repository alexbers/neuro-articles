    have h1 := (ih k (by omega)).2 (by omega)
    have h0 := (ih k (by omega)).1
    rcases k with _ | k
    · omega
    · rw [coeff_X_mul, (ih k (by omega)).2 (by omega), h1, h0]; ring

/-- `(M_{2k}, M_{2k+1}, ∑_{j<k} |γ_j| M_{2j})` -/
def combM (γ : List ℤ) : ℕ → ℕ × ℕ × ℕ :=
  fun n => Nat.rec (motive := fun _ => ℕ × ℕ × ℕ) (1, 2, 0)
    (fun k ih =>
      ((4 * (2 * k) + 7) * ih.2.1 + 2 * (2 * k + 1) * (2 * (2 * k) + 1) * ih.1,
       (4 * (2 * k + 1) + 7) * ((4 * (2 * k) + 7) * ih.2.1 + 2 * (2 * k + 1) * (2 * (2 * k) + 1) * ih.1)
         + 2 * (2 * k + 1 + 1) * (2 * (2 * k + 1) + 1) * ih.2.1,
       ih.2.2 + (γ.getD k 0).natAbs * ih.1)) n

lemma combM_spec (γ : List ℤ) : ∀ n, (combM γ n).1 = (lamM (2 * n)).1 ∧ (combM γ n).2.1 = (lamM (2 * n)).2 ∧
    (combM γ n).2.2 = ∑ j ∈ Finset.range n, (γ.getD j 0).natAbs * (lamM (2 * j)).1 := by
  intro n
  induction n with
  | zero => simp [combM, lamM]
  | succ k ih =>
    obtain ⟨h1, h2, h3⟩ := ih
    have e : lamM (2 * (k + 1)) = ((lamM (2 * k + 1)).2,
        (4 * (2 * k + 1) + 7) * (lamM (2 * k + 1)).2 + 2 * (2 * k + 1 + 1) * (2 * (2 * k + 1) + 1) * (lamM (2 * k + 1)).1) := by
      rw [show 2 * (k + 1) = (2 * k + 1) + 1 by ring, lamM]
    have e' : lamM (2 * k + 1) = ((lamM (2 * k)).2,
        (4 * (2 * k) + 7) * (lamM (2 * k)).2 + 2 * (2 * k + 1) * (2 * (2 * k) + 1) * (lamM (2 * k)).1) := by
      rw [lamM]
    refine ⟨?_, ?_, ?_⟩
    · show (4 * (2 * k) + 7) * (combM γ k).2.1 + 2 * (2 * k + 1) * (2 * (2 * k) + 1) * (combM γ k).1 = _
      rw [e, e', h1, h2]
    · show (4 * (2 * k + 1) + 7) * ((4 * (2 * k) + 7) * (combM γ k).2.1 + 2 * (2 * k + 1) * (2 * (2 * k) + 1) * (combM γ k).1)
         + 2 * (2 * k + 1 + 1) * (2 * (2 * k + 1) + 1) * (combM γ k).2.1 = _
      rw [e, e', h1, h2]
    · show (combM γ k).2.2 + (γ.getD k 0).natAbs * (combM γ k).1 = _
      rw [h3, h1, Finset.sum_range_succ]

/-- balanced base-`B` uniqueness -/
lemma sum_eq_zero_of_small (B : ℤ) (hB : 0 < B) : ∀ (N : ℕ) (c : ℕ → ℤ), (∀ k < N, 2 * |c k| < B) →
    ∑ k ∈ Finset.range N, c k * B ^ k = 0 → ∀ k < N, c k = 0 := by
  intro N
  induction N with
  | zero => intro c _ _ k hk; omega
  | succ N ih =>
    intro c hc hs k hk
    rw [Finset.sum_range_succ'] at hs
    simp only [pow_zero, mul_one] at hs
    have hsplit : ∑ i ∈ Finset.range N, c (i + 1) * B ^ (i + 1) = B * ∑ i ∈ Finset.range N, c (i + 1) * B ^ i := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro i _; ring
    rw [hsplit] at hs
    have hdvd : B ∣ c 0 := ⟨-(∑ i ∈ Finset.range N, c (i + 1) * B ^ i), by linarith⟩
    have hc0 : c 0 = 0 := by
      obtain ⟨q, hq⟩ := hdvd
      have h2 := hc 0 (by omega)
      rw [hq, abs_mul, abs_of_pos hB] at h2
      have : |q| < 1 := by
        by_contra hneg
        rw [not_lt] at hneg
        nlinarith
      have : q = 0 := abs_lt.mp this |>.elim (fun a b => by omega)
      rw [hq, this, mul_zero]
    rw [hc0, add_zero] at hs
    have hrest : ∑ i ∈ Finset.range N, c (i + 1) * B ^ i = 0 := by
      rcases mul_eq_zero.mp hs with h | h
      · omega
      · exact h
    rcases k with _ | k
    · exact hc0
    · exact ih (fun i => c (i + 1)) (fun i hi => hc (i + 1) (by omega)) hrest k (by omega)


/-- sum of absolute values of the entries -/
def sumAbs : List ℤ → ℕ
