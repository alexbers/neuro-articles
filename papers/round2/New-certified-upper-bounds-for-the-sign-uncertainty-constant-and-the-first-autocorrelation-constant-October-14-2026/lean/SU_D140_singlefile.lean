/-- **Main finite theorem.**  `P(u) = ∑_{j ≤ 140} γ_j Λ_{2j}(u)` satisfies `P(0) < 0` and
`P(u) > 0` for every real `u ≥ 193 / 100`. -/
theorem P_sign :
    (∑ j ∈ Finset.range 141, (γ.getD j 0 : ℝ) * Lam (2 * j) 0) < 0 ∧
    ∀ u : ℝ, (193 : ℝ) / 100 ≤ u → 0 < ∑ j ∈ Finset.range 141, (γ.getD j 0 : ℝ) * Lam (2 * j) u := by
  have hP : ∀ u : ℝ, ∑ j ∈ Finset.range 141, (γ.getD j 0 : ℝ) * Lam (2 * j) u = ev Pl u :=
    combo_eq γ Pl 140 2565 hB hE
  constructor
  · rw [hP, ev_zero]
    have := P0_neg
    simp only [decide_eq_true_eq] at this
    exact_mod_cast this
  · intro u hu
    rw [hP]
    apply posCertK2_spec 8069 20 Pl 790528 921600 409600 409600 leaves.tail P_cert u
    have e : ((790528 : ℕ) : ℝ) / ((409600 : ℕ) : ℝ) = (193 : ℝ) / 100 := by norm_num
    rw [e]; exact hu

end SU

