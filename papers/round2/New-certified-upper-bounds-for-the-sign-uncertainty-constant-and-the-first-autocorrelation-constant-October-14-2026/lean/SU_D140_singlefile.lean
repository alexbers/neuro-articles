  | c :: cs, x => by
      rw [List.length_cons, Finset.sum_range_succ', ev_cons, ev_eq_sum cs x, Finset.mul_sum]
      simp only [List.getD_cons_succ, List.getD_cons_zero, pow_zero, mul_one, pow_succ]
      rw [add_comm]; congr 1
      apply Finset.sum_congr rfl; intro j _; ring

open Polynomial in
/-- `ev Pl u = ∑_j γ_j Λ_{2j}(u)` for all real `u`, from two cheap kernel checks at `B = 2^w`. -/
theorem combo_eq (γ Pl : List ℤ) (D w : ℕ)
    (hB : 2 * ((combM γ (D + 1)).2.2 + sumAbs Pl) < 2 ^ w)
    (hE : (combZ γ (2 ^ w) (D + 1)).2.2 = evZ Pl (2 ^ w)) :
    ∀ u : ℝ, ∑ j ∈ Finset.range (D + 1), (γ.getD j 0 : ℝ) * Lam (2 * j) u = ev Pl u := by
  set B : ℤ := 2 ^ w with hBdef
  set Q : ℤ[X] := ∑ j ∈ Finset.range (D + 1), C (γ.getD j 0) * LamP (2 * j) with hQ
  set Pp : ℤ[X] := ∑ k ∈ Finset.range Pl.length, C (Pl.getD k 0) * X ^ k with hPp
  have hQcoeff : ∀ k, Q.coeff k = ∑ j ∈ Finset.range (D + 1), γ.getD j 0 * (LamP (2 * j)).coeff k := by
    intro k; rw [hQ, finsetSum_coeff]; simp only [coeff_C_mul]
  have hPcoeff : ∀ k, Pp.coeff k = Pl.getD k 0 := by
    intro k
    rw [hPp, finsetSum_coeff]
    simp only [coeff_C_mul_X_pow]
    rw [Finset.sum_ite_eq]
    split_ifs with h
    · rfl
    · rw [Finset.mem_range, not_lt] at h
      rw [List.getD_eq_default _ _ h]
  -- coefficient bounds
  have hK : ∀ k, |Q.coeff k| ≤ ((combM γ (D + 1)).2.2 : ℤ) := by
    intro k
    rw [hQcoeff, (combM_spec γ (D + 1)).2.2]
    push_cast
    refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum ?_)
    intro j _
    rw [abs_mul, Int.abs_eq_natAbs (γ.getD j 0)]
    exact mul_le_mul_of_nonneg_left (LamP_coeff_le (2 * j) k).1 (by positivity)
  have hbound : ∀ k, 2 * |(Q - Pp).coeff k| < B := by
    intro k
    rw [coeff_sub, hPcoeff]
    have h1 := hK k
    have h2 := getD_abs_le_sumAbs Pl k
    have h3 : (2 * (((combM γ (D + 1)).2.2 + sumAbs Pl : ℕ) : ℤ)) < B := by rw [hBdef]; exact_mod_cast hB
    push_cast at h3
    have := abs_sub (Q.coeff k) (Pl.getD k 0)
    linarith
  -- vanishing of high coefficients
  set N := 2 * D + 1 + Pl.length + 1 with hN
  have hzero : ∀ k, N ≤ k → (Q - Pp).coeff k = 0 := by
    intro k hk
    rw [coeff_sub, hPcoeff, hQcoeff, List.getD_eq_default _ _ (by omega), sub_zero]
    apply Finset.sum_eq_zero
    intro j hj
    rw [Finset.mem_range] at hj
    rw [(LamP_coeff_zero (2 * j) k (by omega)).1, mul_zero]
  have hdeg : (Q - Pp).natDegree < N := by
    have : (Q - Pp).natDegree ≤ N - 1 := by
      rw [natDegree_le_iff_coeff_eq_zero]
      intro M hM
      exact hzero M (by omega)
    omega
  -- evaluation at B vanishes
  have hevalQ : Q.eval B = (combZ γ B (D + 1)).2.2 := ((combZ_spec γ B (D + 1)).2.2).symm
  have hevalP : Pp.eval B = evZ Pl B := by
    rw [hPp, eval_finsetSum, evZ_eq_sum]
    apply Finset.sum_congr rfl; intro k _; simp
  have hev0 : (Q - Pp).eval B = 0 := by
    rw [eval_sub, hevalQ, hevalP, hBdef, hE, sub_self]
  rw [eval_eq_sum_range' hdeg] at hev0
  have hBpos : (0 : ℤ) < B := by positivity
  have hcz := sum_eq_zero_of_small B hBpos N (fun k => (Q - Pp).coeff k) (fun k _ => hbound k) hev0
  have hQP : Q = Pp := by
    rw [← sub_eq_zero]
    ext k
    rw [coeff_zero]
    rcases Nat.lt_or_ge k N with h | h
    · exact hcz k h
    · exact hzero k h
  intro u
  have h1 : ∑ j ∈ Finset.range (D + 1), (γ.getD j 0 : ℝ) * Lam (2 * j) u = (Q.map (Int.castRingHom ℝ)).eval u := by
    rw [hQ, Polynomial.map_sum, eval_finsetSum]
    apply Finset.sum_congr rfl; intro j _
    rw [Polynomial.map_mul, Polynomial.map_C, eval_mul, eval_C, LamP_eval]
    simp
  have h2 : ev Pl u = (Pp.map (Int.castRingHom ℝ)).eval u := by
    rw [hPp, Polynomial.map_sum, eval_finsetSum, ev_eq_sum]
    apply Finset.sum_congr rfl; intro k _
    simp
  rw [h1, h2, hQP]

