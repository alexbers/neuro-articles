/-- `ev Pl u = ∑_j γ_j Λ_{2j}(u)` for all real `u`, from two cheap kernel checks at `B = 2^w`. -/
theorem combo_eq (γ Pl : List ℤ) (D w : ℕ)
    (hB : 2 * ((combM γ (D + 1)).2.2 + sumAbs Pl) < 2 ^ w)
    (hE : (combZ γ (2 ^ w) (D + 1)).2.2 = evZ Pl (2 ^ w)) :
    ∀ u : ℝ, ∑ j ∈ Finset.range (D + 1), (γ.getD j 0 : ℝ) * Lam (2 * j) u = ev Pl u := by
