  | c :: cs, x => by
      rw [List.length_cons, Finset.sum_range_succ', ev_cons, ev_eq_sum cs x, Finset.mul_sum]
      simp only [List.getD_cons_succ, List.getD_cons_zero, pow_zero, mul_one, pow_succ]
