import Mathlib

/-!
# A kernel-checked certificate for the one-dimensional sign-uncertainty constant

Main theorem (at the end of the file): `SU.P_sign`.  For the explicit integers `γ` and the
scaled Laguerre polynomials `Λ_n = 2^n n! L_n^{(-1/2)}` (defined by their three-term recurrence
as `Lam`), the polynomial `P = ∑_j γ_j Λ_{2j}` satisfies `P(0) < 0` and `P(u) > 0` for all `u ≥ r`.
By the classical Hermite-eigenfunction argument (on paper, see README/paper), `f(x) = P(2πx²)e^{-πx²}`
then shows that the Bourgain–Clozel–Kahane sign-uncertainty constant is at most `r / (2π)`.

Structure:
* polynomials are coefficient lists `List ℤ`, evaluated by Horner's rule (`ev`), with list operations
  (`addL`, `shiftBy`, `scaleDownN`, `mulLin`, `homL`) proved correct w.r.t. real evaluation;
* `Lam`, `lamStep`, `comboAux`: the Laguerre recurrence on lists, proved equal to `Lam`;
* `leafOK`: for a "leaf" `(u0,u1,v0,v1)` it checks that `T(z) = ∑ R_i (u0+u1 z)^i (v0+v1 z)^(d-i)`
  has nonnegative coefficients and `T(0) > 0`, reading the coefficients of `T` off the balanced
  base-`2^w` digits of the single big integer `T(2^w)` (Kronecker substitution; GMP in the kernel);
* `chainOK` / `posCertK`: the leaves cover `[0, ∞)`; `posCertK_spec` gives positivity on `[0, ∞)`.
All heavy computations are done by the kernel (`decide +kernel`); no compiled-code evaluation is trusted.
-/

namespace PolyPos

/-- Horner evaluation of a coefficient list at a real point. -/
def ev : List ℤ → ℝ → ℝ
  | [], _ => 0
  | c :: cs, x => c + x * ev cs x

@[simp] lemma ev_nil (x : ℝ) : ev [] x = 0 := rfl
@[simp] lemma ev_cons (c : ℤ) (cs : List ℤ) (x : ℝ) : ev (c :: cs) x = c + x * ev cs x := rfl

/-- coefficientwise sum -/
def addL : List ℤ → List ℤ → List ℤ
  | [], q => q
  | p@(_ :: _), [] => p
  | a :: p, b :: q => (a + b) :: addL p q

lemma ev_addL : ∀ (p q : List ℤ) (x : ℝ), ev (addL p q) x = ev p x + ev q x
  | [], q, x => by simp [addL]
  | _ :: _, [], x => by simp [addL]
  | a :: p, b :: q, x => by
      simp only [addL, ev_cons, ev_addL p q x]; push_cast; ring

/-- multiply by `(X + a)` -/
def mulXa (a : ℤ) (s : List ℤ) : List ℤ := addL (s.map (fun c => a * c)) (0 :: s)

lemma ev_map_mul (a : ℤ) : ∀ (s : List ℤ) (x : ℝ), ev (s.map (fun c => a * c)) x = a * ev s x
  | [], x => by simp
  | c :: cs, x => by simp only [List.map_cons, ev_cons, ev_map_mul a cs x]; push_cast; ring

lemma ev_mulXa (a : ℤ) (s : List ℤ) (x : ℝ) : ev (mulXa a s) x = (x + a) * ev s x := by
  unfold mulXa
  rw [ev_addL, ev_map_mul, ev_cons]; push_cast; ring

/-- Taylor shift: coefficients of `p(X + a)` -/
def shiftBy (a : ℤ) : List ℤ → List ℤ
  | [] => []
  | c :: cs => addL [c] (mulXa a (shiftBy a cs))

lemma ev_shiftBy (a : ℤ) : ∀ (p : List ℤ) (x : ℝ), ev (shiftBy a p) x = ev p (x + a)
  | [], x => by simp [shiftBy]
  | c :: cs, x => by
      simp only [shiftBy, ev_addL, ev_mulXa, ev_shiftBy a cs x, ev_cons, ev_nil]; ring

/-- `scaleDownN b p`: coefficients `p_k * b^(d-k)`, so `ev (scaleDownN b p) x * b = b^len * ev p (x/b)` -/
def scaleDownN (b : ℕ) : List ℤ → List ℤ
  | [] => []
  | c :: cs => (c * ((b ^ cs.length : ℕ) : ℤ)) :: scaleDownN b cs

lemma ev_scaleDownN (b : ℕ) (hb : (b : ℝ) ≠ 0) : ∀ (p : List ℤ) (x : ℝ),
    ev (scaleDownN b p) x * b = (b : ℝ) ^ p.length * ev p (x / b)
  | [], x => by simp [scaleDownN]
  | c :: cs, x => by
      have ih := ev_scaleDownN b hb cs x
      simp only [scaleDownN, ev_cons, List.length_cons]
      push_cast
      have hb' : (b : ℝ) * (b : ℝ)⁻¹ = 1 := mul_inv_cancel₀ hb
      rw [div_eq_mul_inv]
      rw [div_eq_mul_inv] at ih
      linear_combination x * ih + (-((b : ℝ) ^ cs.length * x * ev cs (x * (b : ℝ)⁻¹))) * hb'

/-! ## Scaled Laguerre polynomials `Λ_n = 2^n n! L_n^{(-1/2)}` -/

/-- `Λ n u = 2^n n! L_n^{(-1/2)}(u)`, defined by the three-term recurrence
`Λ₀ = 1`, `Λ₁ = 1 - 2u`, `Λ_{n+2} = (4n+5-2u) Λ_{n+1} - 2(n+1)(2n+1) Λ_n`. -/
noncomputable def Lam : ℕ → ℝ → ℝ
  | 0, _ => 1
  | 1, u => 1 - 2 * u
  | n + 2, u => (4 * (n : ℝ) + 5 - 2 * u) * Lam (n + 1) u - 2 * ((n : ℝ) + 1) * (2 * n + 1) * Lam n u

/-- one recurrence step on coefficient lists -/
def lamStep (n : ℕ) (a b : List ℤ) : List ℤ :=
  addL (addL (b.map (fun c => (4 * (n : ℤ) + 5) * c)) (0 :: b.map (fun c => -2 * c)))
    (a.map (fun c => -(2 * ((n : ℤ) + 1) * (2 * n + 1)) * c))

lemma ev_lamStep (n : ℕ) (a b : List ℤ) (u : ℝ) :
    ev (lamStep n a b) u = (4 * (n : ℝ) + 5 - 2 * u) * ev b u - 2 * ((n : ℝ) + 1) * (2 * n + 1) * ev a u := by
  unfold lamStep
  rw [ev_addL, ev_addL, ev_map_mul, ev_cons, ev_map_mul, ev_map_mul]
  push_cast; ring

/-- `lamPair n = (coefficients of Λ_n, coefficients of Λ_{n+1})` -/
def lamPair (n : ℕ) : List ℤ × List ℤ :=
  Nat.rec (motive := fun _ => List ℤ × List ℤ) ([1], [1, -2])
    (fun k ih => (ih.2, lamStep k ih.1 ih.2)) n

lemma lamPair_spec (u : ℝ) : ∀ n, ev (lamPair n).1 u = Lam n u ∧ ev (lamPair n).2 u = Lam (n + 1) u := by
  intro n
  induction n with
  | zero => simp [lamPair, Lam]; ring
  | succ k ih =>
    refine ⟨ih.2, ?_⟩
    show ev (lamStep k (lamPair k).1 (lamPair k).2) u = Lam (k + 2) u
    rw [ev_lamStep, ih.1, ih.2, Lam]

/-- `combo γ` = coefficient list of `∑_j γ_j Λ_{2j}`; computed along the recurrence. -/
def comboAux (γ : List ℤ) : ℕ → List ℤ × List ℤ × List ℤ :=
  -- state after k steps: (Λ_{2k}, Λ_{2k+1}, ∑_{j<k} γ_j Λ_{2j})
  fun n => Nat.rec (motive := fun _ => List ℤ × List ℤ × List ℤ) ([1], [1, -2], [])
    (fun k ih =>
      let a := ih.1; let b := ih.2.1; let acc := ih.2.2
      let c := lamStep (2 * k) a b
      let d := lamStep (2 * k + 1) b c
      (c, d, addL acc (a.map (fun t => γ.getD k 0 * t)))) n

lemma comboAux_spec (γ : List ℤ) (u : ℝ) : ∀ n,
    ev (comboAux γ n).1 u = Lam (2 * n) u ∧ ev (comboAux γ n).2.1 u = Lam (2 * n + 1) u ∧
    ev (comboAux γ n).2.2 u = ∑ j ∈ Finset.range n, (γ.getD j 0 : ℝ) * Lam (2 * j) u := by
  intro n
  induction n with
  | zero => simp [comboAux, Lam]; ring
  | succ k ih =>
    obtain ⟨h1, h2, h3⟩ := ih
    refine ⟨?_, ?_, ?_⟩
    · show ev (lamStep (2 * k) (comboAux γ k).1 (comboAux γ k).2.1) u = Lam (2 * (k + 1)) u
      rw [ev_lamStep, h1, h2, show 2 * (k + 1) = 2 * k + 2 by ring, Lam]
    · show ev (lamStep (2 * k + 1) (comboAux γ k).2.1 (lamStep (2 * k) (comboAux γ k).1 (comboAux γ k).2.1)) u
        = Lam (2 * (k + 1) + 1) u
      rw [ev_lamStep, ev_lamStep, h1, h2]
      rw [show 2 * (k + 1) + 1 = (2 * k + 1) + 2 by ring, Lam, show 2 * k + 1 + 1 = 2 * k + 2 by ring, Lam]
    · show ev (addL (comboAux γ k).2.2 ((comboAux γ k).1.map (fun t => γ.getD k 0 * t))) u = _
      rw [ev_addL, ev_map_mul, h3, h1, Finset.sum_range_succ]


/-! ## Kronecker leaf certificates (fast kernel evaluation) -/

/-- multiply by `(u0 + u1 X)` -/
def mulLin (u0 u1 : ℤ) (s : List ℤ) : List ℤ :=
  addL (s.map (fun c => u0 * c)) (0 :: s.map (fun c => u1 * c))

lemma ev_mulLin (u0 u1 : ℤ) (s : List ℤ) (x : ℝ) :
    ev (mulLin u0 u1 s) x = (u0 + u1 * x) * ev s x := by
  unfold mulLin; rw [ev_addL, ev_map_mul, ev_cons, ev_map_mul]; push_cast; ring

/-- homogenised composition `(∑ p_i U^i V^(L-1-i), V^L)` with `U = u0+u1X`, `V = v0+v1X` -/
def homL (u0 u1 v0 v1 : ℤ) : List ℤ → List ℤ × List ℤ
  | [] => ([], [1])
  | c :: cs => (addL ((homL u0 u1 v0 v1 cs).2.map (fun t => c * t)) (mulLin u0 u1 (homL u0 u1 v0 v1 cs).1),
                mulLin v0 v1 (homL u0 u1 v0 v1 cs).2)

lemma homL_spec (u0 u1 v0 v1 : ℤ) (x : ℝ) : ∀ p : List ℤ,
    ev (homL u0 u1 v0 v1 p).2 x = (v0 + v1 * x) ^ p.length ∧
    ev (homL u0 u1 v0 v1 p).1 x * (v0 + v1 * x) =
      (v0 + v1 * x) ^ p.length * ev p ((u0 + u1 * x) / (v0 + v1 * x)) ∨ (v0 + v1 * (x : ℝ) = 0)
  | [] => by left; simp [homL]
  | c :: cs => by
    rcases homL_spec u0 u1 v0 v1 x cs with ⟨h2, h1⟩ | hz
    · left
      refine ⟨?_, ?_⟩
      · simp only [homL, ev_mulLin, h2, List.length_cons]; ring
      · simp only [homL, ev_addL, ev_map_mul, ev_mulLin, h2, List.length_cons, ev_cons]
        by_cases hv : (v0 : ℝ) + v1 * x = 0
        · rw [hv]; simp
        · set V : ℝ := (v0 : ℝ) + v1 * x with hV
          set U : ℝ := (u0 : ℝ) + u1 * x with hU
          set E : ℝ := ev cs (U / V) with hE
          have hdiv : V ^ (cs.length + 1) * (U / V) = U * V ^ cs.length := by
            field_simp; ring
          linear_combination U * h1 - E * hdiv
    · right; exact hz

/-- integer Horner evaluation -/
def evZ : List ℤ → ℤ → ℤ
  | [], _ => 0
  | c :: cs, x => c + x * evZ cs x

lemma evZ_cast (p : List ℤ) (x : ℤ) : ((evZ p x : ℤ) : ℝ) = ev p x := by
  induction p with
  | nil => simp [evZ]
  | cons c cs ih => simp [evZ, ih]

/-- fast homogenised evaluation at integers `X = U(B)`, `Y = V(B)` (what the kernel computes) -/
def homZ (X Y : ℤ) : List ℤ → ℤ × ℤ
  | [] => (0, 1)
  | c :: cs => (c * (homZ X Y cs).2 + X * (homZ X Y cs).1, (homZ X Y cs).2 * Y)

lemma homZ_eq (u0 u1 v0 v1 B : ℤ) : ∀ p : List ℤ,
    homZ (u0 + u1 * B) (v0 + v1 * B) p =
      (evZ (homL u0 u1 v0 v1 p).1 B, evZ (homL u0 u1 v0 v1 p).2 B)
  | [] => by simp [homZ, homL, evZ]
  | c :: cs => by
    have ih := homZ_eq u0 u1 v0 v1 B cs
    have key : ∀ q : List ℤ, ((evZ q B : ℤ) : ℝ) = ev q B := fun q => evZ_cast q B
    simp only [homZ, homL, ih, Prod.mk.injEq]
    constructor
    · apply Int.cast_injective (α := ℝ)
      rw [key, ev_addL, ev_map_mul, ev_mulLin]; push_cast; rw [key, key]
    · apply Int.cast_injective (α := ℝ)
      rw [key, ev_mulLin]; push_cast; rw [key]; ring


/-! ### coefficient bookkeeping -/

lemma getD_addL : ∀ (p q : List ℤ) (j : ℕ), (addL p q).getD j 0 = p.getD j 0 + q.getD j 0
  | [], q, j => by simp [addL]
  | _ :: _, [], j => by simp [addL]
  | a :: p, b :: q, j => by
      cases j with
      | zero => simp [addL]
      | succ j => simp only [addL, List.getD_cons_succ]; exact getD_addL p q j

lemma getD_map_mul (k : ℤ) (s : List ℤ) (j : ℕ) : (s.map (fun c => k * c)).getD j 0 = k * s.getD j 0 := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getD_eq_getElem?_getD]
  cases h : s[j]? <;> simp

lemma getD_mulLin (u0 u1 : ℤ) (s : List ℤ) (j : ℕ) :
    (mulLin u0 u1 s).getD j 0 = u0 * s.getD j 0 + (match j with | 0 => 0 | j + 1 => u1 * s.getD j 0) := by
  unfold mulLin
  rw [getD_addL, getD_map_mul]
  cases j with
  | zero => simp
  | succ j => simp only [List.getD_cons_succ, getD_map_mul]

lemma homL_snd_abs (u0 u1 v0 v1 : ℤ) : ∀ p : List ℤ,
    (homL u0 u1 v0 v1 (p.map abs)).2 = (homL u0 u1 v0 v1 p).2
  | [] => rfl
  | c :: cs => by simp only [List.map_cons, homL, homL_snd_abs u0 u1 v0 v1 cs]

lemma homL_snd_nonneg (u0 u1 v0 v1 : ℤ) (hv0 : 0 ≤ v0) (hv1 : 0 ≤ v1) : ∀ (p : List ℤ) (j : ℕ),
    0 ≤ (homL u0 u1 v0 v1 p).2.getD j 0
  | [], j => by cases j <;> simp [homL]
  | c :: cs, j => by
      simp only [homL, getD_mulLin]
      have h1 := homL_snd_nonneg u0 u1 v0 v1 hv0 hv1 cs j
      cases j with
      | zero => simp only [add_zero]; positivity
      | succ j =>
        have h2 := homL_snd_nonneg u0 u1 v0 v1 hv0 hv1 cs j
        positivity

lemma homL_fst_dom (u0 u1 v0 v1 : ℤ) (hu0 : 0 ≤ u0) (hu1 : 0 ≤ u1) (hv0 : 0 ≤ v0) (hv1 : 0 ≤ v1) :
    ∀ (p : List ℤ) (j : ℕ), |(homL u0 u1 v0 v1 p).1.getD j 0| ≤ (homL u0 u1 v0 v1 (p.map abs)).1.getD j 0
  | [], j => by simp [homL]
  | c :: cs, j => by
      simp only [List.map_cons, homL, getD_addL, getD_map_mul, getD_mulLin, homL_snd_abs]
      have hV := homL_snd_nonneg u0 u1 v0 v1 hv0 hv1 cs j
      have ih := homL_fst_dom u0 u1 v0 v1 hu0 hu1 hv0 hv1 cs j
      cases j with
      | zero =>
        simp only [add_zero]
        calc |c * (homL u0 u1 v0 v1 cs).2.getD 0 0 + u0 * (homL u0 u1 v0 v1 cs).1.getD 0 0|
            ≤ |c * (homL u0 u1 v0 v1 cs).2.getD 0 0| + |u0 * (homL u0 u1 v0 v1 cs).1.getD 0 0| :=
              abs_add_le _ _
          _ = |c| * (homL u0 u1 v0 v1 cs).2.getD 0 0 + u0 * |(homL u0 u1 v0 v1 cs).1.getD 0 0| := by
              rw [abs_mul, abs_mul, abs_of_nonneg hV, abs_of_nonneg hu0]
          _ ≤ _ := by gcongr
      | succ j =>
        have ih2 := homL_fst_dom u0 u1 v0 v1 hu0 hu1 hv0 hv1 cs j
        dsimp only
        calc |c * (homL u0 u1 v0 v1 cs).2.getD (j + 1) 0 + (u0 * (homL u0 u1 v0 v1 cs).1.getD (j + 1) 0 +
              u1 * (homL u0 u1 v0 v1 cs).1.getD j 0)|
            ≤ |c * (homL u0 u1 v0 v1 cs).2.getD (j + 1) 0| + (|u0 * (homL u0 u1 v0 v1 cs).1.getD (j + 1) 0| +
              |u1 * (homL u0 u1 v0 v1 cs).1.getD j 0|) := by
              refine le_trans (abs_add_le _ _) ?_
              gcongr
              exact abs_add_le _ _
          _ = |c| * (homL u0 u1 v0 v1 cs).2.getD (j + 1) 0 + (u0 * |(homL u0 u1 v0 v1 cs).1.getD (j + 1) 0| +
              u1 * |(homL u0 u1 v0 v1 cs).1.getD j 0|) := by
              rw [abs_mul, abs_mul, abs_mul, abs_of_nonneg hV, abs_of_nonneg hu0, abs_of_nonneg hu1]
          _ ≤ _ := by gcongr

lemma homL_abs_nonneg (u0 u1 v0 v1 : ℤ) (hu0 : 0 ≤ u0) (hu1 : 0 ≤ u1) (hv0 : 0 ≤ v0) (hv1 : 0 ≤ v1) :
    ∀ (p : List ℤ) (j : ℕ), 0 ≤ (homL u0 u1 v0 v1 (p.map abs)).1.getD j 0 := by
  intro p j
  exact le_trans (abs_nonneg _) (homL_fst_dom u0 u1 v0 v1 hu0 hu1 hv0 hv1 p j)

lemma getD_le_evZ_one : ∀ (p : List ℤ), (∀ j, 0 ≤ p.getD j 0) → ∀ j, p.getD j 0 ≤ evZ p 1
  | [], _, j => by simp [evZ]
  | c :: cs, h, j => by
      have hcs : ∀ j, 0 ≤ cs.getD j 0 := fun j => by simpa using h (j + 1)
      have hc : 0 ≤ c := by simpa using h 0
      have hsum : 0 ≤ evZ cs 1 := le_trans (hcs 0) (getD_le_evZ_one cs hcs 0)
      cases j with
      | zero => simp only [evZ, List.getD_cons_zero, one_mul]; linarith
      | succ j =>
        have := getD_le_evZ_one cs hcs j
        simp only [evZ, List.getD_cons_succ, one_mul]; linarith

lemma length_homL (u0 u1 v0 v1 : ℤ) : ∀ p : List ℤ,
    (homL u0 u1 v0 v1 p).1.length = p.length ∧ (homL u0 u1 v0 v1 p).2.length = p.length + 1
  | [] => by simp [homL]
  | c :: cs => by
      obtain ⟨h1, h2⟩ := length_homL u0 u1 v0 v1 cs
      have laddL : ∀ a b : List ℤ, (addL a b).length = max a.length b.length := by
        intro a b
        induction a generalizing b with
        | nil => simp [addL]
        | cons x xs ih => cases b with
          | nil => simp [addL]
          | cons y ys => simp [addL, ih]
      simp only [homL, mulLin, laddL, List.length_map, List.length_cons, h1, h2]
      omega

lemma evZ_eq_sum : ∀ (p : List ℤ) (B : ℤ), evZ p B = ∑ j ∈ Finset.range p.length, p.getD j 0 * B ^ j
  | [], B => by simp [evZ]
  | c :: cs, B => by
      rw [List.length_cons, Finset.sum_range_succ', evZ, evZ_eq_sum cs B, Finset.mul_sum]
      simp only [List.getD_cons_succ, List.getD_cons_zero, pow_zero, mul_one, pow_succ]
      rw [add_comm]; congr 1
      apply Finset.sum_congr rfl; intro j _; ring


/-! ### base-`b` digits and a divide-and-conquer lower-bound check -/

/-- `k`-th digit of `N` in base `b`. -/
def dig (b N k : ℕ) : ℕ := N / b ^ k % b

lemma dig_succ (b N k : ℕ) : dig b N (k + 1) = dig b (N / b) k := by
  unfold dig
  rw [pow_succ', Nat.div_div_eq_div_mul]

/-- Digits of `∑ c j * b ^ j` are the `c j` when all `c j < b`. -/
lemma dig_sum (b : ℕ) (hb : 1 < b) : ∀ (m : ℕ) (c : ℕ → ℕ), (∀ j < m, c j < b) →
    ∀ k, k < m → dig b (∑ j ∈ Finset.range m, c j * b ^ j) k = c k := by
  intro m
  induction m with
  | zero => intro c _ k hk; omega
  | succ m ih =>
    intro c hc k hk
    have hsplit : ∑ j ∈ Finset.range (m + 1), c j * b ^ j
        = c 0 + b * ∑ j ∈ Finset.range m, c (j + 1) * b ^ j := by
      rw [Finset.sum_range_succ', Finset.mul_sum]
      simp only [pow_zero, mul_one]
      rw [add_comm]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      ring
    have hb0 : 0 < b := by omega
    have hc0 : c 0 < b := hc 0 (by omega)
    rw [hsplit]
    cases k with
    | zero =>
      unfold dig
      simp only [pow_zero, Nat.div_one]
      rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hc0]
    | succ k =>
      rw [dig_succ]
      have : (c 0 + b * ∑ j ∈ Finset.range m, c (j + 1) * b ^ j) / b
          = ∑ j ∈ Finset.range m, c (j + 1) * b ^ j := by
        rw [Nat.add_mul_div_left _ _ hb0, Nat.div_eq_of_lt hc0, zero_add]
      rw [this]
      exact ih (fun j => c (j + 1)) (fun j hj => hc (j + 1) (by omega)) k (by omega)

lemma dig_mod_pow (b N k j : ℕ) (hb : 0 < b) :
    dig b (N % b ^ (k + 1 + j)) k = dig b N k := by
  unfold dig
  have hbk : 0 < b ^ k := pow_pos hb k
  have hB : b ^ (k + 1 + j) = b ^ k * (b * b ^ j) := by rw [pow_add, pow_succ]; ring
  symm
  conv_lhs => rw [← Nat.mod_add_div N (b ^ (k + 1 + j))]
  rw [hB, mul_assoc, Nat.add_mul_div_left _ _ hbk, mul_assoc, Nat.add_mul_mod_self_left]

lemma dig_div_pow (b N h k : ℕ) : dig b (N / b ^ h) k = dig b N (h + k) := by
  unfold dig
  rw [Nat.div_div_eq_div_mul, ← pow_add]


/-- `chkMinLin b M m N`: the first `m` base-`b` digits of `N` are all `≥ M`. -/
def chkMinLin (b M : ℕ) (m : ℕ) : ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun _ ih N => Nat.ble M (N % b) && ih (N / b)) m

lemma chkMinLin_succ (b M m N : ℕ) :
    chkMinLin b M (m + 1) N = (Nat.ble M (N % b) && chkMinLin b M m (N / b)) := rfl

/-- divide-and-conquer version (blocks of ≤ 64 digits checked linearly) -/
def chkMin (b M : ℕ) (fuel : ℕ) : ℕ → ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → ℕ → Bool) (fun _ _ => false)
    (fun _ ih m N => if m ≤ 64 then chkMinLin b M m N
      else ih (m / 2) (N % b ^ (m / 2)) && ih (m - m / 2) (N / b ^ (m / 2))) fuel

lemma chkMin_succ (b M fuel m N : ℕ) : chkMin b M (fuel + 1) m N =
    (if m ≤ 64 then chkMinLin b M m N
      else chkMin b M fuel (m / 2) (N % b ^ (m / 2)) && chkMin b M fuel (m - m / 2) (N / b ^ (m / 2))) :=
  rfl

lemma chkMinLin_spec (b M : ℕ) : ∀ m N, chkMinLin b M m N = true → ∀ k < m, M ≤ dig b N k := by
  intro m
  induction m with
  | zero => intro N _ k hk; omega
  | succ m ih =>
    intro N h k hk
    rw [chkMinLin_succ, Bool.and_eq_true] at h
    cases k with
    | zero => unfold dig; simpa [Nat.ble_eq] using h.1
    | succ k => rw [dig_succ]; exact ih (N / b) h.2 k (by omega)

lemma chkMin_spec (b M : ℕ) (hb : 0 < b) : ∀ fuel m N, chkMin b M fuel m N = true →
    ∀ k < m, M ≤ dig b N k := by
  intro fuel
  induction fuel with
  | zero => intro m N h; simp [chkMin] at h
  | succ fuel ih =>
    intro m N h k hk
    rw [chkMin_succ] at h
    split_ifs at h with hm
    · exact chkMinLin_spec b M m N h k hk
    · rw [Bool.and_eq_true] at h
      rcases Nat.lt_or_ge k (m / 2) with hk2 | hk2
      · obtain ⟨j, hj⟩ : ∃ j, m / 2 = k + 1 + j := ⟨m / 2 - k - 1, by omega⟩
        have := ih _ _ h.1 k hk2
        rw [hj] at this
        rwa [dig_mod_pow b N k j hb] at this
      · have := ih _ _ h.2 (k - m / 2) (by omega)
        rw [dig_div_pow] at this
        rwa [show m / 2 + (k - m / 2) = k by omega] at this


/-! ### the leaf check -/

lemma ev_pos_of_getD : ∀ (t : List ℤ), (∀ j, 0 ≤ t.getD j 0) → 0 < t.getD 0 0 →
    ∀ z : ℝ, 0 ≤ z → 0 < ev t z
  | [], _, h0, _, _ => by simp at h0
  | c :: cs, hnn, h0, z, hz => by
      have hcs : ∀ j, 0 ≤ cs.getD j 0 := fun j => by simpa using hnn (j + 1)
      have hc : (0 : ℝ) < c := by exact_mod_cast (by simpa using h0)
      have hev : 0 ≤ ev cs z := by
        clear h0 hnn hc
        induction cs with
        | nil => simp
        | cons d ds ih =>
          have hd : (0 : ℝ) ≤ d := by exact_mod_cast (by simpa using hcs 0)
          have := ih (fun j => by simpa using hcs (j + 1))
          simp only [ev_cons]; positivity
      simp only [ev_cons]; positivity

/-- Kernel check of one leaf `(u0,u1,v0,v1)` for `p`, Kronecker base `2^w`. -/
def leafOK (w fuel : ℕ) (p : List ℤ) (u0 u1 v0 v1 : ℕ) : Bool :=
  decide (0 < w) &&
  decide (2 * (homZ ((u0 : ℤ) + u1) ((v0 : ℤ) + v1) (p.map abs)).1 < 2 ^ w) &&
  (fun M : ℕ => chkMin (2 ^ w) (2 ^ (w - 1)) fuel p.length M && Nat.blt (2 ^ (w - 1)) (M % 2 ^ w))
    ((homZ ((u0 : ℤ) + u1 * 2 ^ w) ((v0 : ℤ) + v1 * 2 ^ w) p).1 +
      2 ^ (w - 1) * evZ (List.replicate p.length 1) (2 ^ w)).toNat

lemma leafOK_spec (w fuel : ℕ) (p : List ℤ) (u0 u1 v0 v1 : ℕ)
    (h : leafOK w fuel p u0 u1 v0 v1 = true) :
    ∀ z : ℝ, 0 ≤ z → 0 < ev (homL u0 u1 v0 v1 p).1 z := by
  unfold leafOK at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, Nat.blt_eq] at h
  obtain ⟨⟨hw, hW⟩, hchk, hd0⟩ := h
  set t := (homL u0 u1 v0 v1 p).1 with ht
  set A := (homL u0 u1 v0 v1 (p.map abs)).1 with hA
  set B : ℤ := 2 ^ w with hB
  set O : ℤ := 2 ^ (w - 1) with hO
  have hBO : B = 2 * O := by
    rw [hB, hO, ← pow_succ']; congr 1; omega
  have hOpos : 0 < O := by positivity
  have hW' : (homZ ((u0 : ℤ) + u1) ((v0 : ℤ) + v1) (p.map abs)).1 = evZ A 1 := by
    have := homZ_eq u0 u1 v0 v1 1 (p.map abs)
    simp only [mul_one] at this
    rw [this]
  have hN : (homZ ((u0 : ℤ) + u1 * 2 ^ w) ((v0 : ℤ) + v1 * 2 ^ w) p).1 = evZ t B := by
    rw [homZ_eq u0 u1 v0 v1 (2 ^ w) p]
  rw [hW'] at hW
  rw [hN] at hchk hd0
  -- coefficient bounds |t_j| < O
  have hdom : ∀ j, |t.getD j 0| < O := by
    intro j
    have h1 := homL_fst_dom u0 u1 v0 v1 (by positivity) (by positivity) (by positivity) (by positivity) p j
    have h2 := getD_le_evZ_one A (homL_abs_nonneg u0 u1 v0 v1 (by positivity) (by positivity)
      (by positivity) (by positivity) p) j
    have : 2 * evZ A 1 < 2 * O := by rw [← hBO]; exact_mod_cast hW
    linarith
  have hlen : t.length = p.length := (length_homL u0 u1 v0 v1 p).1
  -- the shifted digits
  set c : ℕ → ℕ := fun j => (t.getD j 0 + O).toNat with hc
  have hcZ : ∀ j, (c j : ℤ) = t.getD j 0 + O := by
    intro j; simp only [hc]
    have := hdom j; rw [abs_lt] at this
    exact Int.toNat_of_nonneg (by linarith)
  have hcB : ∀ j, c j < 2 ^ w := by
    intro j
    have := hdom j; rw [abs_lt] at this
    have h' : (c j : ℤ) < 2 ^ w := by rw [hcZ]; rw [← hB, hBO]; linarith
    exact_mod_cast h'
  have hsum : evZ t B + O * evZ (List.replicate p.length 1) B
      = ∑ j ∈ Finset.range p.length, (c j : ℤ) * B ^ j := by
    rw [evZ_eq_sum, evZ_eq_sum, hlen, List.length_replicate, Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro j hj
    rw [Finset.mem_range] at hj
    have hr : (List.replicate p.length (1 : ℤ)).getD j 0 = 1 := by
      simp [List.getD_eq_getElem?_getD, List.getElem?_replicate, hj]
    rw [hcZ, hr]
    ring
  have hM : (evZ t B + O * evZ (List.replicate p.length 1) B).toNat
      = ∑ j ∈ Finset.range p.length, c j * (2 ^ w) ^ j := by
    rw [hsum]
    have : (∑ j ∈ Finset.range p.length, (c j : ℤ) * B ^ j)
        = ((∑ j ∈ Finset.range p.length, c j * (2 ^ w) ^ j : ℕ) : ℤ) := by
      push_cast; rfl
    rw [this, Int.toNat_natCast]
  rw [hM] at hchk hd0
  have hb1 : 1 < 2 ^ w := Nat.one_lt_two_pow (by omega)
  have hdig : ∀ j < p.length, dig (2 ^ w) (∑ j ∈ Finset.range p.length, c j * (2 ^ w) ^ j) j = c j :=
    fun j hj => dig_sum (2 ^ w) hb1 p.length c (fun j _ => hcB j) j hj
  -- nonnegativity of all coefficients and positivity of the constant one
  have hnn : ∀ j, 0 ≤ t.getD j 0 := by
    intro j
    rcases Nat.lt_or_ge j p.length with hj | hj
    · have := chkMin_spec (2 ^ w) (2 ^ (w - 1)) (by positivity) fuel p.length _ hchk j hj
      rw [hdig j hj] at this
      have h' : ((2 ^ (w - 1) : ℕ) : ℤ) ≤ (c j : ℤ) := by exact_mod_cast this
      rw [hcZ] at h'; push_cast at h'; linarith
    · rw [List.getD_eq_default _ _ (by rw [hlen]; exact hj)]
  have hlen0 : 0 < p.length := by
    by_contra h0
    have h00 : p.length = 0 := by omega
    rw [h00] at hd0
    simp at hd0
  have h0 : 0 < t.getD 0 0 := by
    have := hdig 0 hlen0
    unfold dig at this
    simp only [pow_zero, Nat.div_one] at this
    rw [this] at hd0
    have h' : ((2 ^ (w - 1) : ℕ) : ℤ) < (c 0 : ℤ) := by exact_mod_cast hd0
    rw [hcZ] at h'; push_cast at h'; linarith
  exact ev_pos_of_getD t hnn h0


/-! ### covering `[0, ∞)` by leaves -/

/-- consecutive leaves `(u0,u1,v0,v1)` describe the intervals `[u0/v0, u1/v1)`, the last one
being `[u0/v0, ∞)` (`v1 = 0`). -/
def chainOK : List (ℕ × ℕ × ℕ × ℕ) → Bool
  | [] => false
  | [(_, u1, v0, v1)] => decide (v1 = 0) && decide (0 < u1) && decide (0 < v0)
  | (u0, u1, v0, v1) :: (l' :: rest) =>
      decide (0 < v0) && decide (0 < v1) && decide (u0 * v1 < u1 * v0) &&
        decide (u1 * l'.2.2.1 = l'.1 * v1) && chainOK (l' :: rest)

/-- positivity of `p` at a point `y` of a leaf interval -/
lemma leaf_point (w fuel : ℕ) (p : List ℤ) (u0 u1 v0 v1 : ℕ) (h : leafOK w fuel p u0 u1 v0 v1 = true)
    (hv0 : 0 < v0) (y : ℝ) (hy0 : (u0 : ℝ) / v0 ≤ y)
    (hy1 : (v1 = 0 ∧ 0 < u1) ∨ (0 < v1 ∧ u0 * v1 < u1 * v0 ∧ y < (u1 : ℝ) / v1)) :
    0 < ev p y := by
  have hv0' : (0 : ℝ) < v0 := by exact_mod_cast hv0
  have hden : (0 : ℝ) < u1 - v1 * y := by
    rcases hy1 with ⟨h1, h2⟩ | ⟨h1, _, h3⟩
    · rw [h1]; simp; exact_mod_cast h2
    · have : (0 : ℝ) < v1 := by exact_mod_cast h1
      rw [lt_div_iff₀ this] at h3; linarith
  have hnum : (0 : ℝ) ≤ v0 * y - u0 := by
    rw [div_le_iff₀ hv0'] at hy0; linarith
  set z : ℝ := (v0 * y - u0) / (u1 - v1 * y) with hz
  have hz0 : 0 ≤ z := div_nonneg hnum hden.le
  have hpos := leafOK_spec w fuel p u0 u1 v0 v1 h z hz0
  -- V(z) > 0 and U(z)/V(z) = y
  have hV : (0 : ℝ) < (v0 : ℤ) + (v1 : ℤ) * z := by push_cast; positivity
  have hUV : (((u0 : ℤ) : ℝ) + ((u1 : ℤ) : ℝ) * z) / (((v0 : ℤ) : ℝ) + ((v1 : ℤ) : ℝ) * z) = y := by
    push_cast
    have hD : (v0 : ℝ) + v1 * z ≠ 0 := by push_cast at hV; linarith
    rw [div_eq_iff hD]
    have hzden : z * ((u1 : ℝ) - v1 * y) = v0 * y - u0 := by
      rw [hz]; exact div_mul_cancel₀ _ hden.ne'
    linear_combination hzden
  rcases homL_spec (u0 : ℤ) u1 v0 v1 z p with ⟨h2, h1⟩ | hzero
  · rw [hUV] at h1
    have hVpow : (0 : ℝ) < (((v0 : ℤ) : ℝ) + ((v1 : ℤ) : ℝ) * z) ^ p.length := by positivity
    have : 0 < (((v0 : ℤ) : ℝ) + ((v1 : ℤ) : ℝ) * z) ^ p.length * ev p y := by
      rw [← h1]; exact mul_pos hpos hV
    exact pos_of_mul_pos_right this hVpow.le
  · exfalso; linarith

lemma chain_cover : ∀ (L : List (ℕ × ℕ × ℕ × ℕ)) (w fuel : ℕ) (p : List ℤ),
    chainOK L = true → L.all (fun l => leafOK w fuel p l.1 l.2.1 l.2.2.1 l.2.2.2) = true →
    ∀ (u0 u1 v0 v1 : ℕ) (rest : List (ℕ × ℕ × ℕ × ℕ)), L = (u0, u1, v0, v1) :: rest →
    ∀ y : ℝ, (u0 : ℝ) / v0 ≤ y → 0 < ev p y := by
  intro L
  induction L with
  | nil => intro w fuel p h; simp [chainOK] at h
  | cons l rest ih =>
    intro w fuel p hc hall u0 u1 v0 v1 rest' hL y hy
    simp only [List.cons.injEq] at hL
    obtain ⟨rfl, rfl⟩ := hL
    simp only [List.all_cons, Bool.and_eq_true] at hall
    cases rest with
    | nil =>
      simp only [chainOK, Bool.and_eq_true, decide_eq_true_eq] at hc
      obtain ⟨⟨hv1, hu1⟩, hv0⟩ := hc
      exact leaf_point w fuel p u0 u1 v0 v1 hall.1 hv0 y hy (Or.inl ⟨hv1, hu1⟩)
    | cons l' rest2 =>
      obtain ⟨a', b', c', d'⟩ := l'
      simp only [chainOK, Bool.and_eq_true, decide_eq_true_eq] at hc
      obtain ⟨⟨⟨⟨hv0, hv1⟩, hlt⟩, hjoin⟩, hrest⟩ := hc
      by_cases hyl : y < (u1 : ℝ) / v1
      · exact leaf_point w fuel p u0 u1 v0 v1 hall.1 hv0 y hy (Or.inr ⟨hv1, hlt, hyl⟩)
      · apply ih w fuel p hrest hall.2 a' b' c' d' rest2 rfl y
        rw [not_lt] at hyl
        have hv1' : (0 : ℝ) < v1 := by exact_mod_cast hv1
        -- next leaf starts where this one ends : a'/c' = u1/v1
        have hc' : (0 : ℝ) < c' := by
          rcases rest2 with _ | ⟨l'', r''⟩
          · simp only [chainOK, Bool.and_eq_true, decide_eq_true_eq] at hrest; exact_mod_cast hrest.2
          · obtain ⟨_, _, _, _⟩ := l''
            simp only [chainOK, Bool.and_eq_true, decide_eq_true_eq] at hrest
            exact_mod_cast hrest.1.1.1.1
        have hj : (u1 : ℝ) * c' = a' * v1 := by exact_mod_cast hjoin
        have : (a' : ℝ) / c' = (u1 : ℝ) / v1 := by
          rw [div_eq_div_iff hc'.ne' hv1'.ne']; linarith
        rw [this]; exact hyl

/-- Positivity of `p` on `[0, ∞)` from a chain of leaves starting at `0`. -/
def posCertK (w fuel : ℕ) (p : List ℤ) (L : List (ℕ × ℕ × ℕ × ℕ)) : Bool :=
  chainOK L && L.all (fun l => leafOK w fuel p l.1 l.2.1 l.2.2.1 l.2.2.2) &&
    (match L with | [] => false | l :: _ => decide (l.1 = 0))

lemma posCertK_spec (w fuel : ℕ) (p : List ℤ) (L : List (ℕ × ℕ × ℕ × ℕ))
    (h : posCertK w fuel p L = true) : ∀ y : ℝ, 0 ≤ y → 0 < ev p y := by
  unfold posCertK at h
  simp only [Bool.and_eq_true] at h
  obtain ⟨⟨hc, hall⟩, h0⟩ := h
  intro y hy
  match L, hc, hall, h0 with
  | (u0, u1, v0, v1) :: rest, hc, hall, h0 =>
    simp only [decide_eq_true_eq] at h0
    apply chain_cover _ w fuel p hc hall u0 u1 v0 v1 rest rfl y
    rw [h0]; simpa using hy


/-- Positivity of `p` on `[u0/v0, ∞)`, where `(u0, …, v0, …)` is the first leaf of the chain. -/
def posCertK2 (w fuel : ℕ) (p : List ℤ) (L : List (ℕ × ℕ × ℕ × ℕ)) : Bool :=
  chainOK L && L.all (fun l => leafOK w fuel p l.1 l.2.1 l.2.2.1 l.2.2.2)

lemma posCertK2_spec (w fuel : ℕ) (p : List ℤ) (u0 u1 v0 v1 : ℕ) (rest : List (ℕ × ℕ × ℕ × ℕ))
    (h : posCertK2 w fuel p ((u0, u1, v0, v1) :: rest) = true) :
    ∀ y : ℝ, (u0 : ℝ) / v0 ≤ y → 0 < ev p y := by
  unfold posCertK2 at h
  simp only [Bool.and_eq_true] at h
  exact chain_cover _ w fuel p h.1 h.2 u0 u1 v0 v1 rest rfl


/-! ## Fast check of `P = ∑ γ_j Λ_{2j}` by evaluation at one huge integer -/

open Polynomial in
/-- `Λ_n` as an integer polynomial -/
noncomputable def LamP : ℕ → ℤ[X]
  | 0 => 1
  | 1 => 1 - C 2 * X
  | n + 2 => (C (4 * (n : ℤ) + 5) - C 2 * X) * LamP (n + 1) - C (2 * ((n : ℤ) + 1) * (2 * n + 1)) * LamP n

open Polynomial in
lemma LamP_eval (u : ℝ) : ∀ n, ((LamP n).map (Int.castRingHom ℝ)).eval u = Lam n u
  | 0 => by simp [LamP, Lam]
  | 1 => by simp [LamP, Lam]
  | n + 2 => by
      have h1 := LamP_eval u (n + 1)
      have h0 := LamP_eval u n
      rw [Polynomial.eval_map] at h1 h0 ⊢
      rw [LamP, eval₂_sub, eval₂_mul, eval₂_mul, eval₂_sub, eval₂_mul, eval₂_C, eval₂_C, eval₂_C, eval₂_X,
        h1, h0, Lam]
      simp only [eq_intCast]
      push_cast; ring

open Polynomial in
lemma LamP_eval_int (B : ℤ) (n : ℕ) : (LamP (n + 2)).eval B =
    (4 * (n : ℤ) + 5 - 2 * B) * (LamP (n + 1)).eval B - 2 * ((n : ℤ) + 1) * (2 * n + 1) * (LamP n).eval B := by
  simp only [LamP, eval_sub, eval_mul, eval_C, eval_X]

/-- `(Λ_{2k}(B), Λ_{2k+1}(B), ∑_{j<k} γ_j Λ_{2j}(B))` along the recurrence -/
def combZ (γ : List ℤ) (B : ℤ) : ℕ → ℤ × ℤ × ℤ :=
  fun n => Nat.rec (motive := fun _ => ℤ × ℤ × ℤ) (1, 1 - 2 * B, 0)
    (fun k ih =>
      (( 4 * ((2 * k : ℕ) : ℤ) + 5 - 2 * B) * ih.2.1 - 2 * (((2 * k : ℕ) : ℤ) + 1) * (2 * ((2 * k : ℕ) : ℤ) + 1) * ih.1,
       (4 * ((2 * k + 1 : ℕ) : ℤ) + 5 - 2 * B) *
         ((4 * ((2 * k : ℕ) : ℤ) + 5 - 2 * B) * ih.2.1 - 2 * (((2 * k : ℕ) : ℤ) + 1) * (2 * ((2 * k : ℕ) : ℤ) + 1) * ih.1)
         - 2 * (((2 * k + 1 : ℕ) : ℤ) + 1) * (2 * ((2 * k + 1 : ℕ) : ℤ) + 1) * ih.2.1,
       ih.2.2 + γ.getD k 0 * ih.1)) n

open Polynomial in
lemma combZ_spec (γ : List ℤ) (B : ℤ) : ∀ n,
    (combZ γ B n).1 = (LamP (2 * n)).eval B ∧ (combZ γ B n).2.1 = (LamP (2 * n + 1)).eval B ∧
    (combZ γ B n).2.2 = (∑ j ∈ Finset.range n, C (γ.getD j 0) * LamP (2 * j)).eval B := by
  intro n
  induction n with
  | zero => simp [combZ, LamP]
  | succ k ih =>
    obtain ⟨h1, h2, h3⟩ := ih
    have hA : (LamP (2 * (k + 1))).eval B = (4 * ((2 * k : ℕ) : ℤ) + 5 - 2 * B) * (LamP (2 * k + 1)).eval B
        - 2 * (((2 * k : ℕ) : ℤ) + 1) * (2 * ((2 * k : ℕ) : ℤ) + 1) * (LamP (2 * k)).eval B := by
      rw [show 2 * (k + 1) = 2 * k + 2 by ring, LamP_eval_int]
    have hB : (LamP (2 * (k + 1) + 1)).eval B = (4 * ((2 * k + 1 : ℕ) : ℤ) + 5 - 2 * B) * (LamP (2 * (k + 1))).eval B
        - 2 * (((2 * k + 1 : ℕ) : ℤ) + 1) * (2 * ((2 * k + 1 : ℕ) : ℤ) + 1) * (LamP (2 * k + 1)).eval B := by
      rw [show 2 * (k + 1) + 1 = (2 * k + 1) + 2 by ring, LamP_eval_int, show 2 * k + 1 + 1 = 2 * (k + 1) by ring]
    refine ⟨?_, ?_, ?_⟩
    · show (4 * ((2 * k : ℕ) : ℤ) + 5 - 2 * B) * (combZ γ B k).2.1
        - 2 * (((2 * k : ℕ) : ℤ) + 1) * (2 * ((2 * k : ℕ) : ℤ) + 1) * (combZ γ B k).1 = _
      rw [h1, h2, hA]
    · show (4 * ((2 * k + 1 : ℕ) : ℤ) + 5 - 2 * B) *
         ((4 * ((2 * k : ℕ) : ℤ) + 5 - 2 * B) * (combZ γ B k).2.1 - 2 * (((2 * k : ℕ) : ℤ) + 1) * (2 * ((2 * k : ℕ) : ℤ) + 1) * (combZ γ B k).1)
         - 2 * (((2 * k + 1 : ℕ) : ℤ) + 1) * (2 * ((2 * k + 1 : ℕ) : ℤ) + 1) * (combZ γ B k).2.1 = _
      rw [h1, h2, hB, hA]
    · show (combZ γ B k).2.2 + γ.getD k 0 * (combZ γ B k).1 = _
      rw [h3, h1, Finset.sum_range_succ, eval_add, eval_mul, eval_C]

/-- coefficient bounds: `M₀ = 1, M₁ = 2, M_{n+2} = (4n+7) M_{n+1} + 2(n+1)(2n+1) M_n` -/
def lamM : ℕ → ℕ × ℕ
  | 0 => (1, 2)
  | k + 1 => ((lamM k).2, (4 * k + 7) * (lamM k).2 + 2 * (k + 1) * (2 * k + 1) * (lamM k).1)

open Polynomial in
lemma coeff_X_mul_abs_le (p : ℤ[X]) (M : ℤ) (h : ∀ j, |p.coeff j| ≤ M) (hM : 0 ≤ M) (k : ℕ) :
    |(X * p).coeff k| ≤ M := by
  rcases k with _ | k
  · simp [hM]
  · rw [coeff_X_mul]; exact h k

open Polynomial in
