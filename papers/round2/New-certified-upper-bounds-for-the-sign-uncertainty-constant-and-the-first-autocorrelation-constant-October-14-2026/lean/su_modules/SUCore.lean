  set N := 2 * D + 1 + Pl.length + 1 with hN
  have hzero : ∀ k, N ≤ k → (Q - Pp).coeff k = 0 := by
    intro k hk
    rw [coeff_sub, hPcoeff, hQcoeff, List.getD_eq_default _ _ (by omega), sub_zero]
    apply Finset.sum_eq_zero
    intro j hj
    rw [Finset.mem_range] at hj
    rw [(LamP_coeff_zero (2 * j) k (by omega)).1, mul_zero]
  have hdeg : (Q - Pp).natDegree < N := by
    have : (Q - Pp).natDegree ≤ N - 1 := by
      rw [natDegree_le_iff_coeff_eq_zero]
      intro M hM
      exact hzero M (by omega)
    omega
  -- evaluation at B vanishes
  have hevalQ : Q.eval B = (combZ γ B (D + 1)).2.2 := ((combZ_spec γ B (D + 1)).2.2).symm
  have hevalP : Pp.eval B = evZ Pl B := by
    rw [hPp, eval_finsetSum, evZ_eq_sum]
    apply Finset.sum_congr rfl; intro k _; simp
  have hev0 : (Q - Pp).eval B = 0 := by
    rw [eval_sub, hevalQ, hevalP, hBdef, hE, sub_self]
  rw [eval_eq_sum_range' hdeg] at hev0
  have hBpos : (0 : ℤ) < B := by positivity
  have hcz := sum_eq_zero_of_small B hBpos N (fun k => (Q - Pp).coeff k) (fun k _ => hbound k) hev0
  have hQP : Q = Pp := by
    rw [← sub_eq_zero]
    ext k
    rw [coeff_zero]
    rcases Nat.lt_or_ge k N with h | h
    · exact hcz k h
    · exact hzero k h
  intro u
  have h1 : ∑ j ∈ Finset.range (D + 1), (γ.getD j 0 : ℝ) * Lam (2 * j) u = (Q.map (Int.castRingHom ℝ)).eval u := by
    rw [hQ, Polynomial.map_sum, eval_finsetSum]
    apply Finset.sum_congr rfl; intro j _
    rw [Polynomial.map_mul, Polynomial.map_C, eval_mul, eval_C, LamP_eval]
    simp
  have h2 : ev Pl u = (Pp.map (Int.castRingHom ℝ)).eval u := by
    rw [hPp, Polynomial.map_sum, eval_finsetSum, ev_eq_sum]
    apply Finset.sum_congr rfl; intro k _
    simp
  rw [h1, h2, hQP]

