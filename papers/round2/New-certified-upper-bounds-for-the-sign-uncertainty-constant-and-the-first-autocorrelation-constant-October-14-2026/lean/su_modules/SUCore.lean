    intro k; rw [hQ, finsetSum_coeff]; simp only [coeff_C_mul]
  have hPcoeff : ∀ k, Pp.coeff k = Pl.getD k 0 := by
    intro k
    rw [hPp, finsetSum_coeff]
    simp only [coeff_C_mul_X_pow]
    rw [Finset.sum_ite_eq]
    split_ifs with h
    · rfl
    · rw [Finset.mem_range, not_lt] at h
      rw [List.getD_eq_default _ _ h]
