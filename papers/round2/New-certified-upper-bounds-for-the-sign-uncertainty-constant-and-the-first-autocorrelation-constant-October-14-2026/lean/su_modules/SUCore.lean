    intro k
    rw [hQcoeff, (combM_spec γ (D + 1)).2.2]
    push_cast
    refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum ?_)
    intro j _
    rw [abs_mul, Int.abs_eq_natAbs (γ.getD j 0)]
    exact mul_le_mul_of_nonneg_left (LamP_coeff_le (2 * j) k).1 (by positivity)
  have hbound : ∀ k, 2 * |(Q - Pp).coeff k| < B := by
    intro k
    rw [coeff_sub, hPcoeff]
    have h1 := hK k
    have h2 := getD_abs_le_sumAbs Pl k
    have h3 : (2 * (((combM γ (D + 1)).2.2 + sumAbs Pl : ℕ) : ℤ)) < B := by rw [hBdef]; exact_mod_cast hB
    push_cast at h3
    have := abs_sub (Q.coeff k) (Pl.getD k 0)
    linarith
