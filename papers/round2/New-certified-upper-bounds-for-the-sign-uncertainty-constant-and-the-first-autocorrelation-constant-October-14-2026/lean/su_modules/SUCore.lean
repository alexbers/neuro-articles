  set Q : ℤ[X] := ∑ j ∈ Finset.range (D + 1), C (γ.getD j 0) * LamP (2 * j) with hQ
  set Pp : ℤ[X] := ∑ k ∈ Finset.range Pl.length, C (Pl.getD k 0) * X ^ k with hPp
