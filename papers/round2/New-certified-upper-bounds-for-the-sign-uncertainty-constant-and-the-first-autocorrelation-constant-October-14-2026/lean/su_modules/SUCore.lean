open Polynomial in
lemma LamP_coeff_zero : ∀ n k, n < k → (LamP n).coeff k = 0 ∧ (n + 1 < k → (LamP (n + 1)).coeff k = 0) := by
  intro n
  induction n with
  | zero =>
    intro k hk
    constructor
    · simp only [LamP, coeff_one]; split_ifs <;> omega
