def row (d : Nat) : Nat := if d < 18 then (if d < 9 then (if d < 4 then (if d < 2 then (if d < 1 then (0x0) else ()) else (if d < 3 then () else ())) else (if d < 6 then (if d < 5 then () else ()) else (if d < 7 then () else (if d < 8 then () else ())))) else (if d < 13 then (if d < 11 then (if d < 10 then () else ()) else (if d < 12 then () else ())) else (if d < 15 then (if d < 14 then () else ()) else (if d < 16 then () else (if d < 17 then () else ()))))) else (if d < 27 then (if d < 22 then (if d < 20 then (if d < 19 then () else ()) else (if d < 21 then () else ())) else (if d < 24 then (if d < 23 then () else ()) else (if d < 25 then () else (if d < 26 then () else ())))) else (if d < 32 then (if d < 29 then (if d < 28 then () else ()) else (if d < 30 then () else (if d < 31 then () else ()))) else (if d < 34 then (if d < 33 then (0x0) else ()) else (if d < 35 then () else (if d < 36 then (0x0) else (0x0))))))

