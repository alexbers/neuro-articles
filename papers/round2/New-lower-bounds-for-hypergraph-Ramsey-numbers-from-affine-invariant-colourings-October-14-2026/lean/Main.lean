def row (d : Nat) : Nat := if d < 48 then (if d < 24 then (if d < 12 then (if d < 6 then (if d < 3 then (if d < 1 then (0x0) else (if d < 2 then () else ())) else (if d < 4 then () else (if d < 5 then () else ()))) else (if d < 9 then (if d < 7 then () else (if d < 8 then () else ())) else (if d < 10 then () else (if d < 11 then () else ())))) else (if d < 18 then (if d < 15 then (if d < 13 then () else (if d < 14 then () else ())) else (if d < 16 then () else (if d < 17 then () else ()))) else (if d < 21 then (if d < 19 then () else (if d < 20 then () else ())) else (if d < 22 then () else (if d < 23 then () else ()))))) else (if d < 36 then (if d < 30 then (if d < 27 then (if d < 25 then () else (if d < 26 then () else ())) else (if d < 28 then () else (if d < 29 then () else ()))) else (if d < 33 then (if d < 31 then () else (if d < 32 then () else ())) else (if d < 34 then () else (if d < 35 then () else ())))) else (if d < 42 then (if d < 39 then (if d < 37 then () else (if d < 38 then () else ())) else (if d < 40 then () else (if d < 41 then () else ()))) else (if d < 45 then (if d < 43 then () else (if d < 44 then () else ())) else (if d < 46 then () else (if d < 47 then () else ())))))) else (if d < 72 then (if d < 60 then (if d < 54 then (if d < 51 then (if d < 49 then () else (if d < 50 then () else ())) else (if d < 52 then () else (if d < 53 then () else ()))) else (if d < 57 then (if d < 55 then () else (if d < 56 then () else ())) else (if d < 58 then () else (if d < 59 then () else ())))) else (if d < 66 then (if d < 63 then (if d < 61 then () else (if d < 62 then () else ())) else (if d < 64 then () else (if d < 65 then () else ()))) else (if d < 69 then (if d < 67 then () else (if d < 68 then () else ())) else (if d < 70 then () else (if d < 71 then () else ()))))) else (if d < 84 then (if d < 78 then (if d < 75 then (if d < 73 then () else (if d < 74 then () else ())) else (if d < 76 then () else (if d < 77 then () else ()))) else (if d < 81 then (