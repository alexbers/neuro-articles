/-- The colouring of the 4-set `x < y < z < w` of `{0,…,96}`: the colour of `{0, y-x, z-x, w-x}`
(true = red); translation invariant by construction. -/
def col (x y z w : Nat) : Bool := (row (y - x)).testBit ((z - x) * 97 + (w - x))

def chkRed (v1 : Nat) : Bool :=
  (List.range 97).all fun v2 => !(v1 < v2) || ((List.range 97).all fun v3 => !(v2 < v3 && col 0 v1 v2 v3) || ((List.range 97).all fun v4 => !(v3 < v4 && col 0 v1 v2 v4 && col 0 v1 v3 v4 && col 0 v2 v3 v4 && col v1 v2 v3 v4)))

def chkBlue (v1 : Nat) : Bool :=
  (List.range 97).all fun v2 => !(v1 < v2) || ((List.range 97).all fun v3 => !(v2 < v3 && !(col 0 v1 v2 v3)) || ((List.range 97).all fun v4 => !(v3 < v4 && !(col 0 v1 v2 v4) && !(col 0 v1 v3 v4) && !(col 0 v2 v3 v4) && !(col v1 v2 v3 v4)) || ((List.range 97).all fun v5 => !(v4 < v5 && !(col 0 v1 v2 v5) && !(col 0 v1 v3 v5) && !(col 0 v1 v4 v5) && !(col 0 v2 v3 v5) && !(col 0 v2 v4 v5) && !(col 0 v3 v4 v5) && !(col v1 v2 v3 v5) && !(col v1 v2 v4 v5) && !(col v1 v3 v4 v5) && !(col v2 v3 v4 v5)))))

